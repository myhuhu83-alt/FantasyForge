// ========== 全局状态 ==========
var currentCat = 'all';
var searchText = '';
var elFilters = [];
var currentHighlight = null;

var rankFilters = [];
var sourceFilter = 'all';
var currentLayer = 'surface';
var myCollection = JSON.parse(localStorage.getItem('ff_collection') || '[]');
var codexViewed = JSON.parse(localStorage.getItem('ff_codex') || '{}');

// ========== 工具函数 ==========
function elDots(elements) {
  if (!elements || !elements.length) return '';
  var html = '';
  for (var i = 0; i < elements.length; i++) {
    var e = elements[i];
    var c = EL_COLORS[e] || '#888';
    var n = EL_NAMES[e] || e;
    html += '<span class="el-dot" style="background:' + c + '" title="' + n + '"></span>';
  }
  return html;
}

function rankTag(rank) {
  var r = RANK_LABELS[rank] || RANK_LABELS.c;
  return '<span class="rank-tag" style="background:' + r.color + ';color:#000">' + r.text + '</span>';
}

function esc(s) {
  return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ========== 筛选逻辑 ==========
function pass(item) {
  if (currentCat !== 'all' && item.cat !== currentCat) return false;
  if (searchText) {
    var q = searchText.toLowerCase();
    if (item.name.toLowerCase().indexOf(q) < 0 &&
        item.source.toLowerCase().indexOf(q) < 0 &&
        item.desc.toLowerCase().indexOf(q) < 0) return false;
  }
  if (elFilters.length > 0) {
    var hasAll = true;
    for (var i = 0; i < elFilters.length; i++) {
      if (!item.elements || item.elements.indexOf(elFilters[i]) < 0) {
        hasAll = false;
        break;
      }
    }
    if (!hasAll) return false;
  }
  return true;
}

// ========== 渲染函数 ==========
function render() {
  var filtered = DB.filter(pass);
  var grid = document.getElementById('grid');
  var empty = document.getElementById('empty');
  var infoBar = document.getElementById('infoBar');
  
  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    infoBar.innerHTML = '<span class="item">共 <strong style="color:var(--gold)">0</strong> / ' + DB.length + ' 条</span>';
    return;
  }
  
  empty.style.display = 'none';
  var html = '';
  for (var i = 0; i < filtered.length; i++) {
    var item = filtered[i];
    var hl = (currentHighlight === item.id) ? ' highlight' : '';
    var isCollected = myCollection.indexOf(item.id) >= 0;
    html += '<div class="card' + hl + '" onclick="copyCard(\'' + esc(item.id) + '\')" ondblclick="toggleCollect(\'' + esc(item.id) + '\')">' +
      '<div class="card-header">' +
        '<div class="card-name">' + (isCollected ? '⭐ ' : '') + esc(item.name) + '</div>' +
        '<div class="card-source">' + esc(item.source) + '</div>' +
      '</div>' +
      '<div class="card-desc">' + esc(item.desc) + '</div>' +
      '<div class="card-footer">' +
        '<div class="elements">' + elDots(item.elements) + '</div>' +
        rankTag(item.rank) +
      '</div>' +
    '</div>';
  }
  grid.innerHTML = html;
  infoBar.innerHTML = '<span class="item">显示 <strong style="color:var(--gold)">' + filtered.length + '</strong> / ' + DB.length + ' 条</span>' +
    '<span class="item">收藏 <strong style="color:var(--gold)">' + myCollection.length + '</strong> 条</span>';
}

// ========== 分类导航 ==========
function buildNav() {
  var cats = [
    {id:'all', label:'全部'},
    {id:'weapon', label:'⚔ 武器'},
    {id:'monster', label:'👹 怪兽'},
    {id:'hero', label:'🧙 英雄'},
    {id:'city', label:'🏰 城市'},
    {id:'skill', label:'✨ 技能'},
    {id:'talent', label:'⭐ 天赋'},
    {id:'faction', label:'⚡ 势力'}
  ];
  for (var i = 0; i < cats.length; i++) {
    var c = cats[i];
    c.count = (c.id === 'all') ? DB.length : DB.filter(function(item){ return item.cat === c.id; }).length;
  }
  var nav = document.getElementById('nav');
  var html = '';
  for (var i = 0; i < cats.length; i++) {
    var c = cats[i];
    var on = (currentCat === c.id) ? ' on' : '';
    html += '<button class="nav-btn' + on + '" onclick="setCat(\'' + c.id + '\')">' + c.label + ' <span class="cat-count">' + c.count + '</span></button>';
  }
  nav.innerHTML = html;
}

function setCat(cat) {
  currentCat = cat;
  buildNav();
  render();
}

// ========== 元素筛选 ==========
function buildElFilter() {
  var keys = Object.keys(EL_COLORS);
  var elFilter = document.getElementById('elFilter');
  var html = '';
  for (var i = 0; i < keys.length; i++) {
    var k = keys[i];
    var on = (elFilters.indexOf(k) >= 0) ? ' on' : '';
    html += '<button class="el-btn' + on + '" onclick="toggleEl(\'' + k + '\')">' +
      '<span class="dot" style="background:' + EL_COLORS[k] + '"></span>' +
      EL_NAMES[k] +
    '</button>';
  }
  elFilter.innerHTML = html;
}

function toggleEl(el) {
  var idx = elFilters.indexOf(el);
  if (idx >= 0) {
    elFilters.splice(idx, 1);
  } else {
    elFilters.push(el);
  }
  buildElFilter();
  render();
}

// ========== 等级图例 ==========
function renderLegend() {
  var legend = document.getElementById('legend');
  var ranks = ['legend','ss','s','a','b','c','d','e'];
  var html = '';
  for (var i = 0; i < ranks.length; i++) {
    var r = ranks[i];
    var info = RANK_LABELS[r];
    html += '<div class="legend-item">' +
      '<span class="legend-dot" style="background:' + info.color + '"></span>' +
      info.text +
    '</div>';
  }
  legend.innerHTML = html;
}

// ========== 搜索功能 ==========
function initSearch() {
  var input = document.getElementById('searchInput');
  input.addEventListener('input', function() {
    searchText = this.value;
    render();
  });
}

function randomPick() {
  var filtered = DB.filter(pass);
  if (filtered.length === 0) return;
  var idx = Math.floor(Math.random() * filtered.length);
  currentHighlight = filtered[idx].id;
  render();
  showToast('🎲 随机选中: ' + filtered[idx].name);
  setTimeout(function() {
    currentHighlight = null;
    render();
  }, 3000);
}

// ========== 收藏功能 ==========
function toggleCollect(id) {
  var idx = myCollection.indexOf(id);
  if (idx >= 0) {
    myCollection.splice(idx, 1);
    showToast('已取消收藏');
  } else {
    myCollection.push(id);
    showToast('已添加收藏: ' + (DB.filter(function(i){return i.id===id})[0]||{}).name);
  }
  localStorage.setItem('ff_collection', JSON.stringify(myCollection));
  render();
}

function showAllCollection() {
  if (myCollection.length === 0) {
    showToast('收藏夹为空，双击卡片可添加收藏');
    return;
  }
  currentCat = 'all';
  searchText = '';
  elFilters = [];
  buildNav();
  buildElFilter();
  
  var filtered = DB.filter(function(item) {
    return myCollection.indexOf(item.id) >= 0;
  });
  var grid = document.getElementById('grid');
  var empty = document.getElementById('empty');
  empty.style.display = 'none';
  
  var html = '<div style="grid-column:1/-1;text-align:center;padding:12px 0;color:var(--gold)"><h3>📚 我的收藏 (' + myCollection.length + ')</h3></div>';
  for (var i = 0; i < filtered.length; i++) {
    var item = filtered[i];
    html += '<div class="card" onclick="copyCard(\'' + esc(item.id) + '\')" ondblclick="toggleCollect(\'' + esc(item.id) + '\')">' +
      '<div class="card-header">' +
        '<div class="card-name">⭐ ' + esc(item.name) + '</div>' +
        '<div class="card-source">' + esc(item.source) + '</div>' +
      '</div>' +
      '<div class="card-desc">' + esc(item.desc) + '</div>' +
      '<div class="card-footer">' +
        '<div class="elements">' + elDots(item.elements) + '</div>' +
        rankTag(item.rank) +
      '</div>' +
    '</div>';
  }
  grid.innerHTML = html;
  document.getElementById('infoBar').innerHTML = '<span class="item">收藏 <strong style="color:var(--gold)">' + myCollection.length + '</strong> 条</span>';
  showToast('已显示所有收藏');
}

// ========== 卡片复制 ==========
function copyCard(id) {
  var item = DB.filter(function(i){ return i.id === id; })[0];
  if (!item) return;
  var rankText = RANK_LABELS[item.rank] ? RANK_LABELS[item.rank].text : item.rank;
  var text = '【' + item.name + '】(' + item.source + ')\n' +
    '等级: ' + rankText + ' | 分类: ' + item.cat + '\n' +
    (item.elements && item.elements.length ? '属性: ' + item.elements.map(function(e){ return EL_NAMES[e]||e; }).join('/') + '\n' : '') +
    item.desc;
  
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(function() {
      showToast('已复制: ' + item.name);
    });
  } else {
    showToast('已选中: ' + item.name);
  }
}

// ========== 地图功能 ==========
function toggleMap() {
  var mapWrap = document.getElementById('mapWrap');
  var btn = document.getElementById('mapToggle');
  mapWrap.classList.toggle('on');
  btn.classList.toggle('on');
  if (mapWrap.classList.contains('on')) {
    btn.textContent = '🗺️ 关闭地图';
  } else {
    btn.textContent = '🗺️ 世界地图';
  }
}

function switchLayer(layer) {
  currentLayer = layer;
  
  // Update tabs
  var tabs = document.querySelectorAll('.ltab');
  for (var i = 0; i < tabs.length; i++) {
    tabs[i].classList.remove('on');
    if (tabs[i].getAttribute('data-layer') === layer) {
      tabs[i].classList.add('on');
    }
  }
  
  // Update layer display
  var lays = document.querySelectorAll('.map-lay');
  for (var i = 0; i < lays.length; i++) {
    lays[i].classList.add('hidden');
  }
  var target = document.getElementById('lay-' + layer);
  if (target) target.classList.remove('hidden');
  
  // Update header
  var config = WORLD_LAYERS[layer] || {};
  document.getElementById('layerTitle').textContent = config.name || layer;
  document.getElementById('layerSubtitle').textContent = config.subtitle || '';
  document.getElementById('layerDesc').textContent = config.desc || '';
}

function initMap() {
  // City hover events
  var cities = document.querySelectorAll('.city-ic');
  var tip = document.getElementById('mapTip');
  
  for (var i = 0; i < cities.length; i++) {
    cities[i].addEventListener('mouseenter', function() {
      var id = this.getAttribute('data-id');
      var city = CITY_DATA[id];
      if (!city) return;
      
      var rankInfo = RANK_LABELS[city.rank] || RANK_LABELS.c;
      var quests = city.quests ? city.quests.join('、') : '暂无';
      
      tip.innerHTML = 
        '<div class="map-tip-hdr">' +
          '<h4>' + city.name + '</h4>' +
          '<span class="rank" style="background:' + rankInfo.color + ';color:#000">' + rankInfo.text + '</span>' +
        '</div>' +
        '<div class="map-tip-body">' +
          '<p>' + city.desc + '</p>' +
          '<div class="map-tip-meta">' +
            '<div class="row"><span class="label">统治者:</span><span>' + city.ruler + '</span></div>' +
            '<div class="row"><span class="label">人口:</span><span>' + city.population + '</span></div>' +
            '<div class="row"><span class="label">信仰:</span><span>' + city.religion + '</span></div>' +
            '<div class="row"><span class="label">经济:</span><span>' + city.economy + '</span></div>' +
          '</div>' +
          '<div style="margin-top:8px;font-size:0.72rem;color:var(--text-muted)">' +
            '<strong>任务:</strong> ' + quests +
          '</div>' +
        '</div>';
      tip.classList.add('show');
      
      // Position tip
      var rect = this.getBoundingClientRect();
      var mapRect = document.getElementById('mapMain').getBoundingClientRect();
      var tipX = rect.left - mapRect.left + 20;
      var tipY = rect.top - mapRect.top - 10;
      
      // Keep tip in bounds
      if (tipX + 280 > mapRect.width) tipX = rect.left - mapRect.left - 280;
      tip.style.left = tipX + 'px';
      tip.style.top = tipY + 'px';
    });
    
    cities[i].addEventListener('mouseleave', function() {
      tip.classList.remove('show');
    });
    
    // Double click to show full detail
    cities[i].addEventListener('dblclick', function() {
      var id = this.getAttribute('data-id');
      showCityDetail(id);
    });
  }
}

// ========== 城市/势力详情弹窗 ==========
function showCityDetail(id) {
  var city = CITY_DATA[id];
  if (!city) return;
  
  var rankInfo = RANK_LABELS[city.rank] || RANK_LABELS.c;
  var quests = city.quests || [];
  
  document.getElementById('modalTitle').textContent = city.name;
  document.getElementById('modalBody').innerHTML = 
    '<div class="modal-section">' +
      '<p style="font-size:0.9rem;line-height:1.6">' + city.desc + '</p>' +
    '</div>' +
    '<div class="modal-section">' +
      '<h4>基本信息</h4>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:0.82rem">' +
        '<div><span style="color:var(--text-muted2)">等级:</span> <span style="color:' + rankInfo.color + '">' + rankInfo.text + '</span></div>' +
        '<div><span style="color:var(--text-muted2)">统治者:</span> ' + city.ruler + '</div>' +
        '<div><span style="color:var(--text-muted2)">人口:</span> ' + city.population + '</div>' +
        '<div><span style="color:var(--text-muted2)">信仰:</span> ' + city.religion + '</div>' +
        '<div><span style="color:var(--text-muted2)">经济:</span> ' + city.economy + '</div>' +
        '<div><span style="color:var(--text-muted2)">军事:</span> ' + city.military + '</div>' +
      '</div>' +
    '</div>' +
    '<div class="modal-section">' +
      '<h4>可接任务</h4>' +
      '<div class="modal-tags">' +
        quests.map(function(q) { return '<span class="modal-tag">' + q + '</span>'; }).join('') +
      '</div>' +
    '</div>';
  
  document.getElementById('modalOverlay').classList.add('show');
}

function showFactionDetail(id) {
  var faction = FACTION_DATA[id];
  if (!faction) return;
  
  var typeColors = {light:'#e6c97a', neutral:'#6a9ccf', dark:'#c94040', wasteland:'#a87a3a'};
  var typeNames = {light:'光明', neutral:'中立', dark:'黑暗', wasteland:'废土'};
  
  document.getElementById('modalTitle').textContent = faction.name;
  document.getElementById('modalBody').innerHTML = 
    '<div class="modal-section">' +
      '<span class="modal-tag" style="background:rgba(' + (faction.type==='light'?'230,201,122':faction.type==='dark'?'201,64,64':faction.type==='wasteland'?'168,122,58':'106,156,207') + ',0.2);color:' + (typeColors[faction.type] || '#888') + '">' + (typeNames[faction.type] || '未知') + '阵营</span>' +
    '</div>' +
    '<div class="modal-section">' +
      '<p style="font-size:0.88rem;line-height:1.6">' + faction.desc + '</p>' +
    '</div>' +
    '<div class="modal-section">' +
      '<h4>势力信息</h4>' +
      '<div style="font-size:0.82rem">' +
        '<div style="margin-bottom:4px"><span style="color:var(--text-muted2)">领袖:</span> ' + (faction.leader || '未知') + '</div>' +
        '<div style="margin-bottom:4px"><span style="color:var(--text-muted2)">创立:</span> ' + (faction.founded || '未知') + '</div>' +
        '<div style="margin-bottom:4px"><span style="color:var(--text-muted2)">领土:</span> ' + (faction.territory || '未知') + '</div>' +
      '</div>' +
    '</div>' +
    '<div class="modal-section">' +
      '<h4>敌对势力</h4>' +
      '<div class="modal-tags">' +
        (faction.enemies || []).map(function(e) { 
          var f = FACTION_DATA[e]; 
          return '<span class="modal-tag" style="border-color:rgba(201,64,64,0.4)">' + (f ? f.name : e) + '</span>'; 
        }).join('') +
      '</div>' +
    '</div>';
  
  document.getElementById('modalOverlay').classList.add('show');
}

function closeModal(e) {
  if (e && e.target !== document.getElementById('modalOverlay')) return;
  document.getElementById('modalOverlay').classList.remove('show');
}

// ========== 随机事件 ==========
function triggerRandomEvent() {
  var layer = currentLayer === 'faction' ? 'surface' : currentLayer;
  var events = Object.values(EVENT_TYPES);
  var event = events[Math.floor(Math.random() * events.length)];
  var msg = event.msgs[Math.floor(Math.random() * event.msgs.length)];
  
  var toast = document.getElementById('eventToast');
  toast.innerHTML = '<div class="icon">' + event.icon + '</div><div>' + msg + '</div>';
  toast.style.borderColor = event.color;
  toast.classList.add('show');
  
  setTimeout(function() {
    toast.classList.remove('show');
  }, 3500);
}

// ========== Toast提示 ==========
function showToast(msg) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(function() {
    toast.classList.remove('show');
  }, 2000);
}

// ========== 初始化 ==========
function init() {
  buildNav();
  buildElFilter();
  buildAdvFilter();
  renderLegend();
  initSearch();
  initMap();
  renderEnhanced();
  updateStats();
}

// 启动
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

// 键盘事件
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeModal();
});


// ========== 角色构建器 ==========
var charBuild = {hero:null, weapon:null, skills:[], talents:[]};

function openCharBuilder() {
  var heroes = DB.filter(i => i.cat === 'hero');
  var weapons = DB.filter(i => i.cat === 'weapon');
  var skills = DB.filter(i => i.cat === 'skill');
  var talents = DB.filter(i => i.cat === 'talent');
  
  document.getElementById('modalTitle').textContent = '🧙 角色构建器';
  document.getElementById('modalBody').innerHTML = 
    '<div class="char-builder">' +
    '<div class="char-step"><h4>选择英雄</h4><div class="char-options">' +
    heroes.slice(0,12).map(h => '<div class="char-option" onclick="selectHero(\''+h.id+'\')">'+h.name+'</div>').join('') +
    '</div></div>' +
    '<div class="char-step"><h4>装备武器</h4><div class="char-options">' +
    weapons.filter(w => RANK_LABELS[w.rank] && ['legend','ss','s'].indexOf(w.rank) >= 0).slice(0,10).map(w => '<div class="char-option" onclick="selectWeapon(\''+w.id+'\')">'+w.name+'</div>').join('') +
    '</div></div>' +
    '<div class="char-step"><h4>选择技能 (最多3个)</h4><div class="char-options">' +
    skills.filter(s => RANK_LABELS[s.rank] && ['legend','ss','s','a'].indexOf(s.rank) >= 0).slice(0,12).map(s => '<div class="char-option" onclick="toggleSkill(\''+s.id+'\')">'+s.name+'</div>').join('') +
    '</div></div>' +
    '<div class="char-step"><h4>选择天赋 (最多3个)</h4><div class="char-options">' +
    talents.filter(t => RANK_LABELS[t.rank] && ['legend','ss','s'].indexOf(t.rank) >= 0).slice(0,12).map(t => '<div class="char-option" onclick="toggleTalent(\''+t.id+'\')">'+t.name+'</div>').join('') +
    '</div></div>' +
    '<button class="btn" style="width:100%;margin-top:15px" onclick="generateCharCard()">生成角色卡片</button>' +
    '</div>';
  
  document.getElementById('modalOverlay').classList.add('show');
}

function selectHero(id) {
  charBuild.hero = id;
  showToast('已选择: ' + DB.find(i => i.id === id).name);
}

function selectWeapon(id) {
  charBuild.weapon = id;
  showToast('已装备: ' + DB.find(i => i.id === id).name);
}

function toggleSkill(id) {
  var idx = charBuild.skills.indexOf(id);
  if (idx >= 0) {
    charBuild.skills.splice(idx, 1);
  } else if (charBuild.skills.length < 3) {
    charBuild.skills.push(id);
    showToast('已添加技能: ' + DB.find(i => i.id === id).name);
  } else {
    showToast('最多选择3个技能');
  }
}

function toggleTalent(id) {
  var idx = charBuild.talents.indexOf(id);
  if (idx >= 0) {
    charBuild.talents.splice(idx, 1);
  } else if (charBuild.talents.length < 3) {
    charBuild.talents.push(id);
    showToast('已添加天赋: ' + DB.find(i => i.id === id).name);
  } else {
    showToast('最多选择3个天赋');
  }
}

function generateCharCard() {
  if (!charBuild.hero) {
    showToast('请先选择英雄');
    return;
  }
  
  var hero = DB.find(i => i.id === charBuild.hero);
  var weapon = charBuild.weapon ? DB.find(i => i.id === charBuild.weapon) : null;
  var skills = charBuild.skills.map(id => DB.find(i => i.id === id)).filter(Boolean);
  var talents = charBuild.talents.map(id => DB.find(i => i.id === id)).filter(Boolean);
  
  var card = '【' + hero.name + '】\n';
  card += '来源: ' + hero.source + '\n';
  if (weapon) card += '武器: ' + weapon.name + ' (' + (RANK_LABELS[weapon.rank]||{}).text + ')\n';
  if (skills.length) card += '技能: ' + skills.map(s => s.name).join('、') + '\n';
  if (talents.length) card += '天赋: ' + talents.map(t => t.name).join('、') + '\n';
  card += '\n' + hero.desc;
  
  if (navigator.clipboard) {
    navigator.clipboard.writeText(card);
    showToast('角色卡片已复制到剪贴板');
  }
  
  closeModal();
}

// ========== 随机组队系统 ==========
function randomParty() {
  var heroes = DB.filter(i => i.cat === 'hero');
  var weapons = DB.filter(i => i.cat === 'weapon');
  var skills = DB.filter(i => i.cat === 'skill');
  var talents = DB.filter(i => i.cat === 'talent');
  
  // 随机选4个英雄
  var party = [];
  var usedHeroes = [];
  for (var i = 0; i < 4; i++) {
    var h;
    do {
      h = heroes[Math.floor(Math.random() * heroes.length)];
    } while (usedHeroes.indexOf(h.id) >= 0);
    usedHeroes.push(h.id);
    
    var w = weapons[Math.floor(Math.random() * weapons.length)];
    var s1 = skills[Math.floor(Math.random() * skills.length)];
    var s2 = skills[Math.floor(Math.random() * skills.length)];
    var t = talents[Math.floor(Math.random() * talents.length)];
    
    party.push({hero:h, weapon:w, skills:[s1, s2], talent:t});
  }
  
  var html = '<div class="party-grid">';
  for (var i = 0; i < party.length; i++) {
    var p = party[i];
    var rankInfo = RANK_LABELS[p.hero.rank] || {};
    html += '<div class="party-member">' +
      '<h5>' + p.hero.name + ' <span style="font-size:0.7rem;color:' + (rankInfo.color||'#888') + '">' + (rankInfo.text||'') + '</span></h5>' +
      '<div class="party-slot">⚔️ ' + p.weapon.name + '</div>' +
      '<div class="party-slot">✨ ' + p.skills.map(s => s.name).join(' + ') + '</div>' +
      '<div class="party-slot">⭐ ' + p.talent.name + '</div>' +
    '</div>';
  }
  html += '</div>';
  html += '<div class="party-synergy"><strong>队伍协同:</strong> ' + analyzeSynergy(party) + '</div>';
  html += '<button class="btn" style="width:100%;margin-top:15px" onclick="randomParty()">🔄 重新生成</button>';
  
  document.getElementById('modalTitle').textContent = '👥 随机组队';
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('modalOverlay').classList.add('show');
}

function analyzeSynergy(party) {
  var elements = {};
  party.forEach(p => {
    if (p.hero.elements) p.hero.elements.forEach(e => elements[e] = (elements[e]||0) + 1);
    if (p.weapon.elements) p.weapon.elements.forEach(e => elements[e] = (elements[e]||0) + 1);
  });
  
  var synergies = [];
  Object.keys(elements).forEach(e => {
    if (elements[e] >= 3) synergies.push(EL_NAMES[e] + '共鸣(×' + elements[e] + ')');
  });
  
  return synergies.length ? synergies.join('、') : '无明显协同效果';
}

// ========== 图鉴进度系统 ==========

function markViewed(id) {
  codexViewed[id] = true;
  localStorage.setItem('ff_codex', JSON.stringify(codexViewed));
}

function openCodex() {
  var cats = ['weapon','monster','hero','city','skill','talent','faction'];
  var catNames = {weapon:'武器',monster:'怪兽',hero:'英雄',city:'城市',skill:'技能',talent:'天赋',faction:'势力'};
  
  var html = '<div class="codex-grid">';
  cats.forEach(cat => {
    var total = DB.filter(i => i.cat === cat).length;
    var viewed = DB.filter(i => i.cat === cat && codexViewed[i.id]).length;
    var pct = total > 0 ? Math.round(viewed / total * 100) : 0;
    
    html += '<div class="codex-cat">' +
      '<h5>' + catNames[cat] + ' <span style="font-size:0.8rem">' + pct + '%</span></h5>' +
      '<div class="codex-bar"><div class="codex-fill" style="width:' + pct + '%"></div></div>' +
      '<div class="codex-stats"><span>已查看 ' + viewed + '</span><span>共 ' + total + '</span></div>' +
    '</div>';
  });
  html += '</div>';
  
  var totalItems = DB.length;
  var totalViewed = Object.keys(codexViewed).length;
  var totalPct = Math.round(totalViewed / totalItems * 100);
  
  html += '<div style="text-align:center;margin-top:20px;padding:15px;background:rgba(212,168,83,0.1);border-radius:10px">' +
    '<div style="font-size:1.5rem;color:var(--gold)">' + totalPct + '%</div>' +
    '<div style="font-size:0.8rem;color:var(--text-muted)">总完成度 (' + totalViewed + '/' + totalItems + ')</div>' +
  '</div>';
  
  document.getElementById('modalTitle').textContent = '📖 图鉴进度';
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('modalOverlay').classList.add('show');
}

// ========== 对战模拟器 ==========
function openBattleSim() {
  var heroes = DB.filter(i => i.cat === 'hero');
  
  document.getElementById('modalTitle').textContent = '⚔️ 对战模拟器';
  document.getElementById('modalBody').innerHTML = 
    '<div class="battle-arena">' +
    '<div class="battle-side left"><h4>蓝方</h4><select id="blueHero" style="width:100%;padding:8px;background:var(--bg-surface);border:1px solid var(--border);color:var(--text);border-radius:6px">' +
    heroes.map(h => '<option value="' + h.id + '">' + h.name + '</option>').join('') +
    '</select></div>' +
    '<div class="battle-vs">VS</div>' +
    '<div class="battle-side right"><h4>红方</h4><select id="redHero" style="width:100%;padding:8px;background:var(--bg-surface);border:1px solid var(--border);color:var(--text);border-radius:6px">' +
    heroes.map(h => '<option value="' + h.id + '">' + h.name + '</option>').join('') +
    '</select></div>' +
    '</div>' +
    '<button class="btn" style="width:100%" onclick="startBattle()">开始战斗</button>' +
    '<div class="battle-log" id="battleLog"></div>';
  
  document.getElementById('modalOverlay').classList.add('show');
}

function startBattle() {
  var blueId = document.getElementById('blueHero').value;
  var redId = document.getElementById('redHero').value;
  
  var blue = DB.find(i => i.id === blueId);
  var red = DB.find(i => i.id === redId);
  
  var log = document.getElementById('battleLog');
  log.innerHTML = '';
  
  var blueHp = 100, redHp = 100;
  var round = 1;
  
  function addLog(msg, type) {
    log.innerHTML += '<p class="' + (type||'info') + '">[回合' + round + '] ' + msg + '</p>';
    log.scrollTop = log.scrollHeight;
  }
  
  function battleRound() {
    if (blueHp <= 0 || redHp <= 0 || round > 10) {
      var winner = blueHp > redHp ? blue.name : red.name;
      addLog('🏆 ' + winner + ' 获胜！', 'info');
      return;
    }
    
    // 蓝方攻击
    var blueDmg = Math.floor(Math.random() * 20) + 10;
    redHp -= blueDmg;
    addLog(blue.name + ' 对 ' + red.name + ' 造成 ' + blueDmg + ' 点伤害', 'dmg');
    
    if (redHp <= 0) {
      addLog('🏆 ' + blue.name + ' 获胜！', 'info');
      return;
    }
    
    // 红方攻击
    var redDmg = Math.floor(Math.random() * 20) + 10;
    blueHp -= redDmg;
    addLog(red.name + ' 对 ' + blue.name + ' 造成 ' + redDmg + ' 点伤害', 'dmg');
    
    addLog('血量: ' + blue.name + '(' + Math.max(0,blueHp) + ') vs ' + red.name + '(' + Math.max(0,redHp) + ')', 'info');
    
    round++;
    setTimeout(battleRound, 800);
  }
  
  addLog('⚔️ 战斗开始！' + blue.name + ' VS ' + red.name, 'info');
  setTimeout(battleRound, 500);
}


// ========== 统计仪表盘 ==========
function updateStats() {
  var total = DB.length;
  var legend = DB.filter(i => i.rank === 'legend').length;
  var ss = DB.filter(i => i.rank === 'ss').length;
  var viewed = Object.keys(codexViewed).length;
  
  var dashboard = document.getElementById('statsDashboard');
  if (dashboard) {
    dashboard.innerHTML = 
      '<div class="stat-item"><span class="icon">📊</span><span class="val">' + total + '</span><span class="label">总条目</span></div>' +
      '<div class="stat-item"><span class="icon">⭐</span><span class="val">' + legend + '</span><span class="label">传说</span></div>' +
      '<div class="stat-item"><span class="icon">💎</span><span class="val">' + ss + '</span><span class="label">SS</span></div>' +
      '<div class="stat-item"><span class="icon">👁️</span><span class="val">' + viewed + '</span><span class="label">已查看</span></div>';
  }
}

// ========== 高级筛选 ==========

function buildAdvFilter() {
  var sources = {};
  DB.forEach(i => sources[i.source] = (sources[i.source] || 0) + 1);
  var sourceList = Object.keys(sources).sort((a,b) => sources[b] - sources[a]);
  
  var advFilter = document.getElementById('advFilter');
  if (!advFilter) return;
  
  var ranks = ['legend','ss','s','a','b','c','d','e'];
  var html = '<div class="filter-group"><span class="label">等级:</span>';
  ranks.forEach(r => {
    var on = rankFilters.indexOf(r) >= 0 ? ' on' : '';
    html += '<button class="rank-btn' + on + '" onclick="toggleRankFilter(\'' + r + '\')">' + (RANK_LABELS[r]||{}).text + '</button>';
  });
  html += '</div>';
  
  html += '<div class="filter-group"><span class="label">来源:</span>';
  html += '<select class="source-select" onchange="setSourceFilter(this.value)">';
  html += '<option value="all">全部来源</option>';
  sourceList.slice(0,10).forEach(s => {
    html += '<option value="' + s + '">' + s + ' (' + sources[s] + ')</option>';
  });
  html += '</select></div>';
  
  advFilter.innerHTML = html;
}

function toggleRankFilter(rank) {
  var idx = rankFilters.indexOf(rank);
  if (idx >= 0) {
    rankFilters.splice(idx, 1);
  } else {
    rankFilters.push(rank);
  }
  buildAdvFilter();
  render();
}

function setSourceFilter(source) {
  sourceFilter = source;
  render();
}

// ========== 增强版筛选逻辑 ==========
function passEnhanced(item) {
  if (!pass(item)) return false;
  if (rankFilters.length > 0 && rankFilters.indexOf(item.rank) < 0) return false;
  if (sourceFilter !== 'all' && item.source !== sourceFilter) return false;
  return true;
}

// ========== 增强版渲染 ==========
function renderEnhanced() {
  var filtered = DB.filter(passEnhanced);
  var grid = document.getElementById('grid');
  var empty = document.getElementById('empty');
  
  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  
  empty.style.display = 'none';
  var html = '';
  for (var i = 0; i < filtered.length; i++) {
    var item = filtered[i];
    var hl = currentHighlight === item.id ? ' highlight' : '';
    var isCollected = myCollection.indexOf(item.id) >= 0;
    
    html += '<div class="card' + hl + '" data-rank="' + item.rank + '" onclick="copyCard(\'' + esc(item.id) + '\');markViewed(\'' + esc(item.id) + '\')" ondblclick="toggleCollect(\'' + esc(item.id) + '\')">' +
      '<div class="card-header">' +
        '<div class="card-name">' + (isCollected ? '⭐ ' : '') + esc(item.name) + '</div>' +
        '<div class="card-source">' + esc(item.source) + '</div>' +
      '</div>' +
      '<div class="card-desc">' + esc(item.desc) + '</div>' +
      '<div class="card-footer">' +
        '<div class="elements">' + elDots(item.elements) + '</div>' +
        rankTag(item.rank) +
      '</div>' +
    '</div>';
  }
  grid.innerHTML = html;
  updateStats();
}

// 重写init函数
function initEnhanced() {
  buildNav();
  buildElFilter();
  buildAdvFilter();
  renderLegend();
  initSearch();
  initMap();
  renderEnhanced();
}
</script>
</body>
</html>

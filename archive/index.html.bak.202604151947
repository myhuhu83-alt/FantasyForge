      <div class="city-ic" style="top:40%;left:52%" data-id="abyss_eye" data-rank="legend" data-layer="abyss"><div class="mk" style="background:#7a2a2a"></div><div class="lbl">深渊之眼</div></div>
      <div class="city-ic" style="top:36%;left:72%" data-id="void_pioneer" data-rank="legend" data-layer="abyss"><div class="mk" style="background:#7a2a2a"></div><div class="lbl">虚空先锋</div></div>
      <div class="city-ic" style="top:48%;left:60%" data-id="shadow_covenant" data-rank="legend" data-layer="abyss"><div class="mk" style="background:#7a2a2a"></div><div class="lbl">暗影契约</div></div>
      <div class="map-legend"><h4>深渊势力</h4><div class="r"><div class="mk-s" style="background:#7a2a2a"></div><span>黑暗势力</span></div><div class="r"><div class="mk-s" style="background:#64328c"></div><span>虚空教派</span></div></div>
    </div>
    <!-- Layer: Cosmic -->
    <div class="map-lay hidden" id="lay-cosmic">
      <div class="map-land"></div>
      <div class="city-ic" style="top:36%;left:50%" data-id="crimson_dusk" data-rank="ss" data-layer="cosmic"><div class="mk" style="background:#a070d0"></div><div class="lbl">血色黄昏</div></div>
      <div class="map-legend"><h4>星界势力</h4><div class="r"><div class="mk-s" style="background:#a070d0"></div><span>血族议会</span></div><div class="r"><div class="mk-s" style="background:#e6c97a"></div><span>圣光领域</span></div></div>
    </div>
    <!-- Layer: Faction -->
    <div class="map-lay hidden" id="lay-faction">
      <div class="map-land"></div>
      <div class="faction-list">
        <div class="faction-card" data-faction="alliance" onclick="showFactionDetail('alliance')"><h5>☀️ 洛丹伦联盟</h5><p>人类七王国组成的同盟，信仰圣光与正义</p><span class="type-tag" style="background:rgba(230,201,122,0.2);color:#e6c97a">光明</span></div>
        <div class="faction-card" data-faction="silver_hand" onclick="showFactionDetail('silver_hand')"><h5>✨ 白银之手</h5><p>乌瑟尔·光明使者建立的圣骑士团</p><span class="type-tag" style="background:rgba(230,201,122,0.2);color:#e6c97a">光明</span></div>
        <div class="faction-card" data-faction="mage_council" onclick="showFactionDetail('mage_council')"><h5>🔮 法师议会</h5><p>赫拉迪姆兄弟会的继承者，研究奥术与知识</p><span class="type-tag" style="background:rgba(230,201,122,0.2);color:#e6c97a">光明</span></div>
        <div class="faction-card" data-faction="horde" onclick="showFactionDetail('horde')"><h5>⚔️ 兽人部落</h5><p>以奥格瑞玛为中心的游牧帝国，崇尚战歌与荣耀</p><span class="type-tag" style="background:rgba(106,156,207,0.2);color:#6a9ccf">中立</span></div>
        <div class="faction-card" data-faction="frostwolf" onclick="showFactionDetail('frostwolf')"><h5>❄️ 霜狼氏族</h5><p>德拉诺最古老的兽人氏族之一</p><span class="type-tag" style="background:rgba(106,156,207,0.2);color:#6a9ccf">中立</span></div>
        <div class="faction-card" data-faction="sin_dorei" onclick="showFactionDetail('sin_dorei')"><h5>🌙 辛多雷</h5><p>血精灵王国，追逐太阳之井的力量</p><span class="type-tag" style="background:rgba(106,156,207,0.2);color:#6a9ccf">中立</span></div>
        <div class="faction-card" data-faction="wasteland" onclick="showFactionDetail('wasteland')"><h5>☢️ 废土行者</h5><p>末世废土中幸存者的结盟</p><span class="type-tag" style="background:rgba(168,122,58,0.2);color:#a87a3a">废土</span></div>
        <div class="faction-card" data-faction="shadow" onclick="showFactionDetail('shadow')"><h5>🌑 暗影议会</h5><p>古尔丹建立的秘密术士组织</p><span class="type-tag" style="background:rgba(122,42,42,0.2);color:#c94040">黑暗</span></div>
        <div class="faction-card" data-faction="sauron" onclick="showFactionDetail('sauron')"><h5>👁️ 索伦势力</h5><p>黑暗魔君索伦的魔多帝国</p><span class="type-tag" style="background:rgba(122,42,42,0.2);color:#c94040">黑暗</span></div>
        <div class="faction-card" data-faction="abyssal" onclick="showFactionDetail('abyssal')"><h5>🌀 深渊之眼</h5><p>来自深海的神秘教派，窥见宇宙的终极秘密</p><span class="type-tag" style="background:rgba(122,42,42,0.2);color:#c94040">黑暗</span></div>
      </div>
    </div>
    <div class="map-tip" id="mapTip"></div>
  </div>
</div>

<div class="grid" id="grid"></div>
<div class="empty" id="empty" style="display:none">
  <div class="empty-icon">🔮</div>
  <div>没有找到匹配的内容</div>
</div>
<div class="toast" id="toast"></div>
<div class="event-toast" id="eventToast"></div>

<!-- Detail Modal -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hdr">
      <h3 id="modalTitle">详情</h3>
      <button class="modal-close" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<script>

// ========== 元素配置 ==========
var EL_COLORS = {
  fire:"rgba(220,60,20,1)", ice:"rgba(60,160,220,1)", electric:"rgba(240,200,20,1)",
  dark:"rgba(100,50,140,1)", light:"rgba(240,200,80,1)", fighting:"rgba(200,80,40,1)",
  psychic:"rgba(180,80,220,1)", ghost:"rgba(120,110,180,1)", dragon:"rgba(160,60,200,1)",
  fairy:"rgba(240,120,180,1)", ground:"rgba(180,130,60,1)", steel:"rgba(160,150,180,1)",
  poison:"rgba(120,180,40,1)", water:"rgba(40,100,200,1)", grass:"rgba(60,180,60,1)",
  flying:"rgba(100,160,220,1)", rock:"rgba(180,110,60,1)", bug:"rgba(120,180,30,1)",
  normal:"rgba(160,160,150,1)"
};
var EL_NAMES = {
  fire:"火", ice:"冰", electric:"电", dark:"暗", light:"光", fighting:"格斗",
  psychic:"超能", ghost:"幽灵", dragon:"龙", fairy:"妖精", ground:"地面",
  steel:"钢", poison:"毒", water:"水", grass:"草", flying:"飞行", rock:"岩石",
  bug:"虫", normal:"普通"
};
var RANK_LABELS = {
  legend:{text:"传说", color:"#e6c97a"},
  ss:{text:"SS", color:"#a070d0"},
  s:{text:"S", color:"#6a9ccf"},
  a:{text:"A", color:"#70d080"},
  b:{text:"B", color:"#c9c77a"},
  c:{text:"C", color:"#c79b56"},
  d:{text:"D", color:"#995f2c"},
  e:{text:"E", color:"#664a29"}
};

var DB = [
  {id:'w01',name:'霜之哀伤',rank:'legend',cat:'weapon',source:'魔兽世界',elements:['ice','dark','fighting'],desc:'洛丹伦王子阿尔萨斯在面对亡灵天灾时插入的诅咒之剑，由巫妖王亲自铸造。剑身散发着幽蓝寒光，能吸取受害者的灵魂为己所用，持有者会逐渐被其意志侵蚀。'},
  {id:'w02',name:'埃癸斯神盾',rank:'legend',cat:'weapon',source:'希腊神话',elements:['light','steel'],desc:'众神之王宙斯的青铜盾牌，由独眼巨人打造。盾面上刻有美杜莎的头颅图案，举起此盾者可免疫一切攻击，是神盾中最坚固的护佑。'},
  {id:'w03',name:'雷神之锤',rank:'legend',cat:'weapon',source:'北欧神话',elements:['electric','steel'],desc:'雷神托尔的专属战锤，由冰霜矮人打造。蕴含毁灭性的雷电之力，被扔出后会自动飞回持有者手中，只有被选中者才能举起它。'},
  {id:'w04',name:'石中剑',rank:'legend',cat:'weapon',source:'亚瑟王传说',elements:['light','steel'],desc:'被亚瑟王从石头中拔出的命运之剑，只有真正的王者才能将其拔出。剑身刻有神圣铭文，持剑者将获得统治不列颠的资格。'},
  {id:'w05',name:'永恒之枪·冈格尼尔',rank:'legend',cat:'weapon',source:'北欧神话',elements:['light','steel'],desc:'奥丁神的永恒之枪，枪身由世界树的枝条制成，柄上刻着卢恩符文。掷出必中，落地后将化为彩虹桥连接天地。'},
  {id:'w06',name:'无毁的湖光',rank:'legend',cat:'weapon',source:'亚瑟王传说',elements:['light','water'],desc:'圆桌骑士兰斯洛特的佩剑，剑刃如湖水般清澈澄净。据说此剑永不染血，一旦饮血便会自动折断。'},
  {id:'w07',name:'格拉姆德',rank:'legend',cat:'weapon',source:'北欧神话',elements:['fire','steel'],desc:'齐格弗里德的传说之剑，由矮人工匠雷金打造。此剑饮过龙血后刀锋永不损坏，斩断一切阻挡。'},
  {id:'w08',name:'杜兰达尔',rank:'legend',cat:'weapon',source:'基督教传说',elements:['light','steel'],desc:'大天使米迦勒的神圣之剑，剑身由天堂的光铸造。此剑永不染血，光芒能驱散一切黑暗与邪恶。'},
  {id:'w09',name:'胜利之剑·莱瓦汀',rank:'legend',cat:'weapon',source:'北欧神话',elements:['fire','light'],desc:'弗雷神赠予北欧英雄的火焰圣剑，由流星碎片锻造。剑身在日落时最为炽热，持有者将战无不胜。'},
  {id:'w10',name:'阿斯卡隆',rank:'legend',cat:'weapon',source:'暗黑破坏神',elements:['dark','light'],desc:'圣骑士正义之锤的灵魂铸造的圣剑，由天使净化堕落的灵魂而成。剑身散发着圣光与暗影交织的诡异光辉。'},
  {id:'w11',name:'霜狼之牙',rank:'legend',cat:'weapon',source:'魔兽世界',elements:['ice','steel'],desc:'霜狼氏族传承的族长战斧，由杜隆坦亲手锻造。斧刃永不生锈，在寒冰中淬炼千年，蕴含着霜狼氏族的古老灵魂。'},
  {id:'w12',name:'黑暗裁决',rank:'legend',cat:'weapon',source:'指环王',elements:['dark','ghost'],desc:'刚铎执政官使用的幽暗长剑，剑刃由黑铁锻造，剑柄镶嵌着暗影宝石。此剑在黑暗中发出幽幽绿光，是对抗黑暗势力的禁忌武器。'},
  {id:'w13',name:'缚焰',rank:'b',cat:'weapon',source:'暗黑破坏神',elements:[],desc:'传奇单手剑，攻击时剑身缠绕燃烧的锁链，像一条愤怒的火蛇咬向敌人。'},
  {id:'w14',name:'安达莉尔之光',rank:'b',cat:'weapon',source:'暗黑破坏神',elements:[],desc:'源自恐惧之核的光明战锤，锤头镶嵌着天使的羽毛，是对抗地狱恶魔的圣器。'},
  {id:'w15',name:'霜棘',rank:'b',cat:'weapon',source:'暗黑破坏神',elements:[],desc:'冰系魔法战锤，击中时释放刺骨寒霜，能在敌人身上留下永久的冻痕。'},
  {id:'w16',name:'虚空之锤',rank:'b',cat:'weapon',source:'魔兽世界',elements:[],desc:'德莱尼主祭的战锤，敲击时震动空间裂隙，能在短距离内撕裂现实。'},
  {id:'w17',name:'夜刃',rank:'b',cat:'weapon',source:'最终幻想14',elements:[],desc:'夜行者在暗夜中使用的双刃匕首，无声致命，在阴影中几近隐形。'},
  {id:'w18',name:'龙魂战斧',rank:'b',cat:'weapon',source:'英雄无敌',elements:[],desc:'据传由龙的魂魄锻造，每一击都带着龙焰，能震慑低等龙族。'},
  {id:'w19',name:'断离',rank:'b',cat:'weapon',source:'艾尔登法环',elements:[],desc:'死亡仪式之剑，由死亡本身铸造，对生者有致命的切割力。'},
  {id:'w20',name:'暗影猎手',rank:'b',cat:'weapon',source:'最终幻想14',elements:[],desc:'绝境战中使用的神秘弓弩，箭矢在暗影中穿行，无声无息。'},
  {id:'w21',name:'烈焰长剑',rank:'b',cat:'weapon',source:'魔兽世界',elements:[],desc:'附魔了火焰伤害的标准军用剑，剑身常年燃烧着橘红色的火焰，是法师塔的标准装备。'},
  {id:'w22',name:'冰霜之刃',rank:'b',cat:'weapon',source:'魔兽世界',elements:[],desc:'达拉然法师打造的附魔武器，挥舞时留下冰霜轨迹，能减缓敌人的移动速度。'},
  {id:'w23',name:'雷霆匕首',rank:'ss',cat:'weapon',source:'原创',elements:[],desc:'来源：暗黑破坏神系列·刺客专属传说匕首，由暗黑贤者用陨铁与恶魔之血反复淬炼。特性：表面流动微弱蓝色奥术光芒，攻击时注入易燃毒素使火焰伤害翻倍。适合环境：室内狭窄空间、暗杀任务、偷袭作战。适合使用者：刺客、游侠、暗黑职业者。'},
  {id:'w24',name:'毒牙短剑',rank:'b',cat:'weapon',source:'暗黑破坏神',elements:[],desc:'淬了剧毒的短剑，刀刃泛着不祥的紫光，伤口极难愈合。'},
  {id:'w25',name:'岩石战锤',rank:'c',cat:'weapon',source:'上古卷轴',elements:[],desc:'用整块火山岩雕琢的重锤，朴实无华但威力惊人，矮人族的标准武器。'},
  {id:'w26',name:'钢刃长戟',rank:'c',cat:'weapon',source:'英雄无敌',elements:[],desc:'人类骑士团的标准长戟，锋利的钢刃能轻易刺穿铠甲。'},
  {id:'w27',name:'风之弓',rank:'b',cat:'weapon',source:'最终幻想14',elements:[],desc:'精灵游侠的配弓，箭矢如风般无声，射程极远。'},
  {id:'w28',name:'暗影匕首',rank:'b',cat:'weapon',source:'魔兽世界',elements:[],desc:'被暗影附魔的匕首，在黑暗中几乎隐形，是潜行者的首选。'},
  {id:'w29',name:'妖精之弓',rank:'b',cat:'weapon',source:'指环王',elements:[],desc:'森林精灵的短弓，箭矢带着妖精的祝福，对邪恶生物有额外伤害。'},
  {id:'w30',name:'火焰法杖',rank:'b',cat:'weapon',source:'魔兽世界',elements:[],desc:'火焰法师的标准法杖，顶端镶嵌着永恒燃烧的火晶石。'},
  {id:'w31',name:'生锈的短剑',rank:'c',cat:'weapon',source:'魔兽世界',elements:[],desc:'一把生锈的铁剑，剑刃已经钝了，但勉强能用来防身。新手冒险者的起步装备。'},
  {id:'w32',name:'木棒',rank:'c',cat:'weapon',source:'宠物小精灵',elements:[],desc:'一根结实的橡木棒，虽然简陋但也很实用。卡比兽的最爱，用来恢复体力。'},
  {id:'w33',name:'铁剑',rank:'c',cat:'weapon',source:'英雄无敌',elements:[],desc:'最基础的铁制长剑，没有附魔，但胜在可靠耐用。民兵的标准装备。'},
  {id:'w34',name:'石斧',rank:'c',cat:'weapon',source:'上古卷轴',elements:[],desc:'粗糙的石制斧头，兽人部落中常见的工具兼武器。'},
  {id:'w35',name:'训练用匕首',rank:'c',cat:'weapon',source:'暗黑破坏神',elements:[],desc:'武僧训练用的短匕首，刀刃被刻意钝化，避免训练时受伤。'},
  {id:'w36',name:'猎人弓',rank:'b',cat:'weapon',source:'最终幻想14',elements:[],desc:'普通猎人使用的复合弓，做工简单但足够狩猎野味。'},
  {id:'w37',name:'学徒法杖',rank:'c',cat:'weapon',source:'魔兽世界',elements:[],desc:'法师学徒的第一根法杖，没有附魔，但代表了踏上魔法之路的第一步。'},
  {id:'w38',name:'铜锤',rank:'c',cat:'weapon',source:'英雄无敌',elements:[],desc:'沉重的铜制战锤，虽然材质普通，但一击足以砸碎骨头。'},
  {id:'w39',name:'短矛',rank:'c',cat:'weapon',source:'指环王',elements:[],desc:'兽人军队的标准短矛，粗糙但致命，适合近距离投掷。'},
  {id:'w40',name:'青铜刀',rank:'c',cat:'weapon',source:'最终幻想14',elements:[],desc:'青铜锻造的弯刀，武士学徒的练习用刀。'},
  {id:'w41',name:'铁斧',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'普通的铁制斧头，伐木和战斗都能用，野蛮人喜欢的武器。'},
  {id:'w42',name:'弯刀',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'弯曲的刀刃，适合劈砍，草原骑兵的标配。'},
  {id:'w43',name:'短剑',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'短小精悍的剑，适合近身缠斗和巷战。'},
  {id:'w44',name:'长剑',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'标准的长剑，平衡感好，适合各种战斗风格。'},
  {id:'w45',name:'双手剑',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'需要双手握持的巨剑，威力巨大但速度较慢。'},
  {id:'w46',name:'骑士剑',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'骑士的标准配剑，剑柄有十字护手，象征正义。'},
  {id:'w47',name:'弯刀',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'沙漠民族喜爱的弯刀，刃口锋利，适合快速斩击。'},
  {id:'w48',name:'匕首',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'小巧的匕首，适合暗杀和投掷，刺客的必备武器。'},
  {id:'w49',name:'飞刀',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'专门用于投掷的小刀，轻薄锋利，百步之外可取人性命。'},
  {id:'w50',name:'手斧',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'小巧的斧头，既能砍柴也能战斗，可投掷。'},
  {id:'w51',name:'战斧',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'巨大的战斧，需要双手挥舞，能劈开铠甲。'},
  {id:'w52',name:'战锤',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'沉重的战锤，能砸扁盾牌和骨头，无视铠甲。'},
  {id:'w53',name:'钉头锤',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'带刺的战锤，打击面有尖刺，能造成可怕的伤口。'},
  {id:'w54',name:'战戟',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'长柄武器，一头是斧一头是矛，能刺能劈。'},
  {id:'w55',name:'长矛',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'最基础的长柄武器，简单实用，步兵方阵的标配。'},
  {id:'w56',name:'长枪',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'比长矛更长更坚韧，骑兵冲锋的利器。'},
  {id:'w57',name:'戟',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'复杂的长柄武器，结合了矛、斧、钩的特点，高手才能用好。'},
  {id:'w58',name:'长棍',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'最简单的武器，一根木棍，高手能用得出神入化。'},
  {id:'w59',name:'齐眉棍',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'长度与眉毛齐平的棍子，武僧常用的武器。'},
  {id:'w60',name:'节棍',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'多节棍，用铁链连接，挥舞起来难以预测。'},
  {id:'w61',name:'短弓',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'小巧的弓，适合骑马和丛林作战，但射程较短。'},
  {id:'w62',name:'长弓',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'巨大的弓，需要很大力气才能拉开，射程远威力大。'},
  {id:'w63',name:'复合弓',rank:'s',cat:'weapon',source:'原创',elements:[],desc:'用多种材料制成的弓，性能优异，工匠的心血结晶。'},
  {id:'w64',name:'弩',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'机械驱动的弓，不需要太多训练就能使用，威力巨大。'},
  {id:'w65',name:'轻弩',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'小型的弩，可以单手使用，适合暗杀。'},
  {id:'w66',name:'重弩',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'巨大的弩，需要机械辅助上弦，能穿透城墙。'},
  {id:'w67',name:'法杖',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'最基础的法杖，没有附魔，但能帮助法师集中精神。'},
  {id:'w68',name:'橡木法杖',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'用橡木制成的法杖，能增强自然魔法。'},
  {id:'w69',name:'紫杉木法杖',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'用紫杉木制成的法杖，能增强黑暗魔法，受到诅咒。'},
  {id:'w70',name:'世界树枝法杖',rank:'a',cat:'weapon',source:'原创',elements:[],desc:'用世界树枝制成的传说法杖，蕴含创世之力。'},
  {id:'w71',name:'魔杖',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'短小的魔杖，方便携带，适合施放快速魔法。'},
  {id:'w72',name:'鹰首魔杖',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'杖首雕刻成鹰头的魔杖，能增强风系魔法和飞行魔法。'},
  {id:'w73',name:'蛇首魔杖',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'杖首雕刻成蛇头的魔杖，能增强毒素魔法和诅咒。'},
  {id:'w74',name:'龙首魔杖',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'杖首雕刻成龙头的魔杖，能增强火系魔法和龙语魔法。'},
  {id:'w75',name:'圣像',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'神圣的圣像，能增强神圣魔法，驱散亡灵。'},
  {id:'w76',name:'圣杯',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'神圣的圣杯，盛着圣水，能治愈伤病和驱除邪恶。'},
  {id:'w77',name:'圣典',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'神圣的典籍，记载着神圣的经文，能增强神圣魔法。'},
  {id:'w78',name:'图腾',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'原始部落的图腾，能增强自然魔法和祖先之力。'},
  {id:'w79',name:'萨满鼓',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'萨满的神鼓，鼓声能沟通天地，召唤灵魂。'},
  {id:'w80',name:'骨杖',rank:'b',cat:'weapon',source:'原创',elements:[],desc:'用骨头制成的法杖，能增强亡灵魔法。'},
  {id:'lw01',name:'永恒之枪·冈格尼尔',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：北欧神话·奥丁的神枪，由世界树枝条打磨成形，枪身刻满卢恩文字。特性：一旦投出必然命中目标，从无失手，被它锁定的事物无法通过任何手段闪避。适合环境：远程突袭、一击必杀的关键时刻、猎杀高机动目标。适合使用者：主神、猎人、战争领袖。'},
  {id:'lw02',name:'雷神之锤·姆乔尔尼尔',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：北欧神话·雷神托尔的战锤，矮人兄弟用垂死之星核心锻造，锤柄是世界树根部。特性：可召唤九天雷霆降下毁灭性打击，雷电自动追踪敌人；持有者获得飞行能力。适合环境：户外开阔地带、暴风雨天气、破坏性任务。适合使用者：雷霆之神、雷电系战士、力量型英雄。'},
  {id:'lw03',name:'胜利之剑·莱瓦汀',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：北欧神话·苏尔特尔的烈焰之剑，诸神黄昏时焚毁九大世界。特性：剑刃永远燃烧金红色永恒烈焰，靠近的一切都会被点燃，对冰系和水系敌人有毁灭性压制。适合环境：火系主场、冰雪环境、攻城战。适合使用者：火焰巨人、苏尔特尔的继承者、毁灭者。'},
  {id:'lw04',name:'海皇三叉戟',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·海皇波塞冬的三叉戟，由海神用深海玄铁亲手锻造。特性：挥动可掀起滔天巨浪淹没一切，持有者可号令所有海洋生物与海元素。适合环境：海洋、湖泊、暴雨天气、近海岛屿。适合使用者：海皇、水系法师、海洋统治者。'},
  {id:'lw05',name:'冥王之剑·哈迪斯之刃',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·冥王哈迪斯的佩剑，由冥铁打造，刃上流动亡者的叹息。特性：被它杀死的敌人灵魂直接被收割进入冥界，无法转世轮回；对活物造成灵魂层面的真实伤害。适合环境：冥界、墓地、暗影位面、亡灵战场。适合使用者：冥王、死神、亡灵君主。'},
  {id:'lw06',name:'阿波罗神弓',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·太阳神阿波罗的弓箭，弓身由金色阳光凝结而成，弦是七彩虹光。特性：射程极远，可从千里之外精准命中目标；箭矢能带来光明治愈或瘟疫毁灭两种效果。适合环境：光明之地、神圣领域、远距离精确打击场合。适合使用者：太阳神、光明系弓箭手、远距离狙击者。'},
  {id:'lw07',name:'阿尔忒弥斯银弓',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·狩猎女神阿尔忒弥斯的银弓，月神用月光与银矿石锻造，弦是极细的月光丝线。特性：月光为弦、星辰为矢，在夜晚和月光下威力倍增；持有者可隐匿于月光中，射击无声无息。适合环境：夜晚、森林、月光下、隐秘狩猎。适合使用者：月神、游侠、森林猎手、刺客型射手。'},
  {id:'lw08',name:'赫淮斯托斯之锤',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·火神赫淮斯托斯的锻造锤，由火山核心熔岩与玄铁反复淬炼。特性：能用它打造出任何神器；锤击本身蕴含毁灭性火焰伤害；有几率触发"神器诞生"效果。适合环境：锻造工坊、熔岩洞穴、制造业系场景。适合使用者：火神、工匠、锻造师、创造者。'},
  {id:'lw09',name:'雅典娜神盾·埃癸斯',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·智慧女神雅典娜的神盾埃癸斯，由山羊皮编织而成，中心镶嵌美杜莎的石化头颅。特性：盾牌本身坚不可摧，能完全抵挡任何攻击；石化凝视能让直视持有者的敌人瞬间石化。适合环境：防守战、正面对决、需要绝对防御的场合。适合使用者：智慧女神、战士型坦克、圣骑士。'},
  {id:'lw10',name:'时间权杖·克洛诺斯之镰',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·泰坦之王克罗诺斯的镰刀，能切割时间线本身。特性：被它击中的事物会被送往过去或未来；持有者可以缓慢局部区域的时间流速。适合环境：时空错乱的位面、时间魔法领域、操控时间的关键时刻。适合使用者：时间泰坦、时间法师、命运操控者。'},
  {id:'lw11',name:'命运织布机',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：希腊神话·命运三女神诺恩的织机，由命运之线编织而成，每个丝结都是一个生命的命运。特性：持有者可以改变他人的命运走向；能预知即将发生的事件；能编织对自己有利的因果。适合环境：命运对抗、预言场景、操控因果的场合。适合使用者：命运女神、预言者、操纵者。'},
  {id:'lw12',name:'如意金箍棒',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：中国神话·孙悟空的如意金箍棒，原为大禹治水时的定海神针，重达一万三千五百斤。特性：能随心变化大小长短；可入海镇水、可变长击天；挥动时能召唤海啸与风暴。适合环境：海洋场景、变化多端的战场、需要多用途武器的场合。适合使用者：齐天大圣、变形战士、水系战斗。'},
  {id:'lw13',name:'轩辕剑',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：中国上古神话·黄帝所铸的神剑，剑身一面刻日月星辰，一面刻山川草木。特性：剑出鞘时天地为之变色；对邪恶有天然克制；持有者可感知天下大事。适合环境：王朝战争、正义之战、神魔对决。适合使用者：天子、黄帝传承者、正义领袖。'},
  {id:'lw14',name:'东皇钟',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：中国上古神话·鸿蒙初开时的第一神器，上古十大神器之首。特性：可创造或毁灭一个小世界；钟声能镇压一切邪祟，使敌人暂时失去行动能力；蕴含宇宙诞生时的原始能量。适合环境：创世级场景、镇压上古邪物、混沌领域。适合使用者：东皇太一、创世神、宇宙级存在。'},
  {id:'lw15',name:'盘古斧',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：中国上古神话·盘古开天辟地所用的神斧，宇宙诞生之初的原始武器。特性：具有开辟天地、创造世界的力量；一斧下去可以分开混沌、划分阴阳。适合环境：创世级场景、开辟新世界、混沌对抗。适合使用者：创世神、盘古传承者、世界开创者。'},
  {id:'lw16',name:'圣剑·达贡之神力',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·代达罗斯之殇（圣剑），被称为大炮，由传说中的工匠为猎杀神祇而锻造。特性：极高暴击伤害，普通攻击有一定几率造成2.2倍伤害；获得后可拾取，死亡后掉落引发争夺战。适合环境：后期决战、战略级争夺、翻盘关键道具。适合使用者：核心后期输出、物理C位、一击定胜负者。'},
  {id:'lw17',name:'辉耀·代达罗斯之殇',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·辉耀，由神圣光芒凝聚而成，被动光环每秒对周围敌人造成60点纯粹伤害。特性：被动光环持续灼烧周围敌人，无视护甲和魔抗；具有范围持续伤害效果。适合环境：持续消耗战、需要清兵能力的场合、阵地战。适合使用者：近战AOE战士、需要持续输出的坦克。'},
  {id:'lw18',name:'林肯法球',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·林肯法球，由一位天才炼金术士发明，能反弹任何单体指向性法术。特性：每12秒可完全抵挡一次单体法术攻击，无论该法术有多强大；附带法术吸血与一定生命恢复。适合环境：法术密集战场、需要反制单体爆发的场合。适合使用者：核心C位、需要免疫控制的英雄。'},
  {id:'lw19',name:'蝴蝶',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·蝴蝶，由精灵族用稀有的蝴蝶翼粉编织而成，敏捷型英雄的终极追求。特性：大幅提升敏捷属性；提供30%闪避几率；对闪避失败的普攻有额外反击效果。适合环境：敏捷英雄后期、需要生存与输出兼顾的场合。适合使用者：敏捷型核心、暗夜猎手、游走型英雄。'},
  {id:'lw20',name:'不朽尸王之锤',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·撒旦之守护，由被诅咒的暗黑骑士使用堕落灵魂锻造。特性：25%生命偷取；主动技能可驱散自身所有debuff并获得爆发性生命回复。适合环境：持久消耗战、团战拉扯、需要持续吸血的场合。适合使用者：物理战士、后期主力、需要极限生存的核心。'},
  {id:'lw21',name:'刷新球',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·刷新球，由时间魔法的残余碎片凝聚而成，蕴含重置时间的力量。特性：激活后可立即刷新所有技能冷却时间，让所有技能重新可用。适合环境：技能型英雄、需要连续施放核心大招的场合、关键时刻爆发。适合使用者：技能型核心、大招流法师、需要二次爆发的英雄。'},
  {id:'lw22',name:'闪烁匕首·闪烁之刃',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·闪烁匕首，由空间裂缝中的稀有矿物打造，能撕裂空间本身。特性：瞬间传送到任意位置，范围达1350单位；无视所有地形障碍物。适合环境：复杂地形、需要快速切入或撤退的场合、追猎与逃生的关键时刻。适合使用者：所有需要机动性的英雄、刺客、后期生存核心。'},
  {id:'lw23',name:'希瓦之守护',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·希瓦之守护，由极北冰原的寒冰精魄凝结而成。特性：被动光环使周围敌人减速并降低其护甲；主动技能释放刺骨寒霜，瞬间冻结附近所有敌人。适合环境：控制型战场、需要限制敌人移动的团战。适合使用者：辅助型坦克、团队控制者、阵地战英雄。'},
  {id:'lw24',name:'撒分之毁灭之角',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·邪恶镰刀，由月之女祭司献祭自身获得，能将敌人变成无害的绵羊。特性：极高的智力加成；主动技能可将敌人变羊，解除其所有装备效果。适合环境：控制单体关键敌人、反制敌方核心的场合。适合使用者：智力型控制法师、需要反制手段的辅助。'},
  {id:'lw25',name:'隐匿之刃·幽穴',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：刀塔2·圣剑（大炮），刺客型武器，在阴影中发动攻击时附带致命毒液。特性：攻击附带持续性毒素伤害，目标无法回复生命直到毒发身亡；暴击时毒素伤害翻倍。适合环境：暗杀任务、持久战、需要阻止敌人回复的场合。适合使用者：刺客、影系英雄、狙击型后排输出。'},
  {id:'lw26',name:'三相之力',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·三相之力，由三块远古符石镶嵌在古老权杖中，蕴含三种力量的完美融合。特性：完美融合攻击力、法术强度与攻击速度；对敌人造成伤害时会获得额外移动速度加成。适合环境：需要全面属性的混战、需要追击与拉扯的团战。适合使用者：战士型英雄、混合伤害角色、需要灵活走位的使用者。'},
  {id:'lw27',name:'无尽之刃',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·无尽之刃，由瓦罗兰大陆最古老的铁矿锻造，刃中蕴含着红色暴戾之气。特性：暴击伤害大幅提升，是暴击体系的核心组件。适合环境：暴击流出装、后期决战、需要爆发性物理伤害的场合。适合使用者：ADC核心、物理暴击型射手、后期大核。'},
  {id:'lw28',name:'魔切·卢登的激荡',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·魔切，由蓝水晶吸收日月精华后进化而成，原本是一件成长型装备。特性：叠满后每次攻击都会释放储存的法力值造成额外伤害；附带高额法力值加成。适合环境：法力消耗型战斗、需要持续输出的法师、需要蓝量支撑的技能流。适合使用者：技能型法师、消耗型角色、持续输出者。'},
  {id:'lw29',name:'黑色切割者',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·黑色切割者，由被诅咒的暗黑骑士使用冤魂锻造，刃面漆黑如夜。特性：切割敌人护甲的同时提升自身移动速度；攻击同一目标时效果可叠加。适合环境：对抗高护甲坦克、需要持续追击的场合。适合使用者：战士、刺客、需要克制护甲英雄的角色。'},
  {id:'lw30',name:'死亡之帽·灭世之帽',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·灭世之帽，由陨落的星辰碎片镶嵌而成，传说是毁灭之神遗留的冠冕。特性：法术强度大幅提升，是所有AP英雄的终极追求。适合环境：需要极限法术爆发的场合、决战时刻、一击定胜负。适合使用者：AP法师、爆发型法师、需要极限法强的角色。'},
  {id:'lw31',name:'守护天使·复活甲',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·守护天使，又名复活甲，由神圣金属与天使羽翼的碎片融合锻造。特性：持有者死亡后可在原地复活，恢复一定生命值后继续战斗。适合环境：后期生存、关键团战、需要复活能力的场合。适合使用者：战士、坦克、核心C位、所有需要保命装的角色。'},
  {id:'lw32',name:'中娅沙漏·金身',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·中娅沙漏，由古代炼金术士用黄金与星尘混合打造，表面镶嵌魔法符文。特性：激活后持有者进入凝滞状态，免疫所有伤害持续2.5秒，期间无法移动但可施法。适合环境：塔下反杀、躲避关键技能的场合、需要等待队友支援的时刻。适合使用者：AP法师、战士、所有需要主动保命的角色。'},
  {id:'lw33',name:'饮血剑',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·饮血剑，由吸血伯爵的佩剑改造而成，剑柄处镶嵌永不干涸的血晶石。特性：生命偷取效果极高；溢出的治疗量转化为可叠加的护盾。适合环境：持续站撸、需要续航的近战战斗、消耗战。适合使用者：物理战士、ADC、需要极限吸血的角色。'},
  {id:'lw34',name:'疾射火炮',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·疾射火炮，由工程学天才用静电水晶改造的巨型弩弓，弦上缠绕雷电。特性：大幅提升攻击距离和暴击率；充能完毕后下次攻击可造成额外魔法伤害。适合环境：超远程狙击、安全输出距离、ADC手短问题的解决方案。适合使用者：ADC、远程射手、需要安全输出空间的角色。'},
  {id:'lw35',name:'幕刃·夜之锋刃',rank:'legend',cat:'weapon',source:'原创',elements:[],desc:'来源：英雄联盟·幕刃，由暗影刺客用深海黑曜石打造，刃上刻满冤魂的名字。特性：在敌人视野外发动攻击必定暴击并造成减速；对暴露视野的敌人有额外伤害加成。适合环境：暗杀任务、夜战、伏击作战。适合使用者：刺客、隐身英雄、暗杀型角色。'},
  {id:'bw01',name:'木剑',rank:'e',cat:'weapon',source:'原创',elements:[],desc:'来源：新手村铁匠铺，由普通橡木削制而成，边缘经过打磨。特性：重量轻、易上手，但不耐用，容易损坏。适合环境：新手村试炼、打稻草人练习。适合使用者：新手冒险者、初次学剑者。来源：新手村铁匠铺老卡尔用自家后院的歪脖子橡木削制而成，边缘磨得还算光滑，但仔细看能看到老卡尔手抖留下的波浪形痕迹。剑柄缠着洗得发白的布条，是他老伴生前织的。特性：重量轻、易上手，但不耐用，砍不了几次就会卷刃。适合环境：新手村试炼、打稻草人练习。适合使用者：新手冒险者、初次学剑者。'},
  {id:'bw14',name:'干草叉',rank:'e',cat:'weapon',source:'原创',elements:[],desc:'来源：农具三齿叉，用来叉干草。特性：能刺人但不好控制。适合环境：农场、紧急情况。适合使用者：农民。'},
  {id:'bw15',name:'擀面杖',rank:'e',cat:'weapon',source:'原创',elements:[],desc:'来源：厨房用具，一根结实的枣木棍。特性：打人很疼但不致命。适合环境：厨房、主妇防身。适合使用者：厨师、主妇。'},
  {id:'bw16',name:'锅铲',rank:'e',cat:'weapon',source:'原创',elements:[],desc:'来源：铁制锅铲，边缘锋利。特性：炒菜还行，打架有点滑稽。适合环境：厨房。适合使用者：厨师。'},
  {id:'bw17',name:'铁剑',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：小镇铁匠铺打造的量产铁剑，剑刃开了锋但没开血槽。特性：中规中矩的武器，适合大多数情况。适合环境：冒险者常备武器、雇佣兵装备。适合使用者：战士、冒险者、雇佣兵。来源：小镇铁匠「铁锤」哈里森打造的第17把铁剑——哈里森一生打造了99把剑，这把是他成名前的作品，剑刃上还能看到他学徒时代手不稳留下的细小锤痕，但剑脊笔直、重心完美，是把被低估的好剑。特性：中规中矩的武器，适合大多数情况。适合环境：冒险者常备武器、雇佣兵装备。适合使用者：战士、冒险者、雇佣兵。'},
  {id:'bw22',name:'长矛',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：铁制矛头配上硬木杆，是步兵方阵的标配。特性：长度优势，适合结阵作战，单打独斗吃亏。适合环境：方阵作战、对抗骑兵。适合使用者：重步兵、枪兵。'},
  {id:'bw23',name:'战斧',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：单手战斧，铁制斧刃配硬木柄。特性：劈砍威力大，但攻速慢。适合环境：破甲作战、对付重甲敌人。适合使用者：战士、狂战士。'},
  {id:'bw24',name:'钉头锤',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：铁制锤头布满尖刺，专门对付重甲。特性：能砸穿板甲，造成内伤。适合环境：对抗重甲骑士。适合使用者：战士、破甲兵。'},
  {id:'bw25',name:'长弓',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：英格兰长弓样式，需要很大臂力。特性：射程远、穿透力强。适合环境：阵地战、远程狙击。适合使用者：弓箭手、长弓手。'},
  {id:'bw26',name:'十字弩',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：机械弩，上弦需要用脚踩，威力巨大。特性：不需要太多训练就能使用，威力大但射速慢。适合环境：守城、伏击。适合使用者：民兵、守城士兵。'},
  {id:'bw27',name:'锁子甲',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：铁环一个个扣起来制成，穿在皮甲外面。特性：能防劈砍，但防不住刺击和钝器。适合环境：中装作战、常规战斗。适合使用者：战士、雇佣兵。'},
  {id:'bw28',name:'鸢盾',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：骑兵用的鸢形盾，上宽下窄，能护住腿部。特性：骑兵标配，能挡箭矢和刀剑。适合环境：骑兵作战、冲锋陷阵。适合使用者：骑兵、骑士。'},
  {id:'bw29',name:'弯刀',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：草原民族的武器，刀身弯曲，适合劈砍。特性：骑在马上劈砍威力大，步战也不错。适合环境：骑兵作战、草原作战。适合使用者：骑兵、游牧民。'},
  {id:'bw30',name:'飞斧',rank:'d',cat:'weapon',source:'原创',elements:[],desc:'来源：可投掷的小斧头，北方蛮族常用。特性：投掷后能回旋，不容易接住。适合环境：丛林作战、骚扰敌人。适合使用者：蛮族战士、斥候。'},
  {id:'bw31',name:'精钢长剑',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：城市铁匠铺用精钢打造，经过淬火和回火。特性：锋利、耐用、不易生锈，冒险者的首选武器。适合环境：各种战斗场合，适应性强。适合使用者：战士、冒险者、剑术爱好者。'},
  {id:'bw32',name:'复合弓',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：用木材、牛角、牛筋多层胶合而成，威力巨大。特性：射程远、穿透力强，需要专业训练。适合环境：大规模战争、猎场。适合使用者：专业弓箭手、游侠。'},
  {id:'bw33',name:'板甲',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：全身覆盖的钢板甲，由专业铠甲匠打造。特性：防护力极强，但非常重，影响机动性。适合环境：阵地战、正面硬刚。适合使用者：重骑兵、重步兵。'},
  {id:'bw34',name:'塔盾',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：一人高的巨大盾牌，能完全遮住身体。特性：防御面积大，但非常笨重，需要双手持。适合环境：守城、方阵作战。适合使用者：重步兵、盾兵。'},
  {id:'bw35',name:'巨剑',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：双手使用的巨大长剑，剑刃宽厚。特性：威力巨大，能一剑劈断盾牌，但攻速极慢。适合环境：开阔场地、对付无甲敌人。适合使用者：力量型战士、狂战士。'},
  {id:'bw36',name:'战锤',rank:'c',cat:'weapon',source:'原创',elements:[],desc:'来源：双手战锤，锤头巨大，专门砸穿重甲。特性：对重甲敌人毁灭性打击，能造成内伤。适合环境：对抗重甲骑士、破城。适合使用者：重战士、破甲兵。'},
  {id:'lm01',name:'虚空之龙·奈萨里奥',rank:'legend',cat:'monster',source:'魔兽世界',elements:[],desc:'曾经的大地守护者，如今的灭世者。他的鳞片是最坚硬的铠甲，他的吐息能撕裂艾泽拉斯的大地。'},
  {id:'lm02',name:'泰坦守护者·提尔',rank:'legend',cat:'monster',source:'魔兽世界',elements:[],desc:'秩序的守护者，用钢铁与正义铸造的神圣战士。即使失去了一只手，他的战斗意志依然能撼动苍穹。'},
  {id:'lm03',name:'元素领主·奥拉基尔',rank:'legend',cat:'monster',source:'魔兽世界',elements:[],desc:'风元素的至高统治者，天空与风暴的化身。他的愤怒能掀起席卷整个大陆的飓风。'},
  {id:'lm04',name:'冥神·哈迪斯',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'冥界之主，掌管死亡与来世的至高神。任何生命在他面前都如同尘埃。'},
  {id:'lm05',name:'太阳神·阿波罗',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'太阳与艺术之神，驾驶金色战车划过天际，他的光芒能驱散一切黑暗与邪恶。'},
  {id:'lm06',name:'深渊之主·克苏鲁',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'沉睡在海底城市拉莱耶的旧日支配者，当群星归位时，他将苏醒并带来无尽的疯狂。'},
  {id:'lm07',name:'世界蛇·耶梦加得',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'环绕整个世界的巨蛇，它的身体能围绕地球一圈，它的毒液能毒杀诸神。'},
  {id:'lm08',name:'火巨人·苏尔特尔',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'穆斯贝尔海姆的统治者，手持燃烧的烈焰之剑，诸神黄昏时将焚毁整个世界。'},
  {id:'lm09',name:'冰霜巨人·伊米尔',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'最初的巨人，世界的始祖，他的身体化为大地、海洋与天空。'},
  {id:'lm10',name:'恶魔之主·撒旦',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'地狱的统治者，背叛上帝的堕天使之王，诱惑人类走向堕落的深渊。'},
  {id:'lm11',name:'时空龙·克罗诺斯',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'时间的守护者，能操控时间流速，让一瞬变为永恒，让永恒化为一瞬。'},
  {id:'lm12',name:'命运三女神·诺恩',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'编织命运之网的三位女神，过去、现在与未来都在她们的织机上显现。'},
  {id:'lm13',name:'凤凰·菲尼克斯',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'永生不死的神鸟，浴火重生，每一次死亡都意味着更强大的新生。'},
  {id:'lm14',name:'九尾妖狐·玉藻前',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'拥有九条尾巴的妖狐，每一条尾巴都蕴含毁天灭地的力量，魅惑众生的绝世妖姬。'},
  {id:'lm15',name:'齐天大圣·孙悟空',rank:'legend',cat:'monster',source:'原创',elements:[],desc:'花果山水帘洞美猴王，大闹天宫的齐天大圣，如意金箍棒能横扫一切妖魔鬼怪。'},
  {id:'lm16',name:'Roshan',rank:'legend',cat:'monster',source:'刀塔2',elements:[],desc:'不朽之物的守护者，地图上最强的中立生物。每20分钟重生一次，击杀者获得不朽之存档与复活次数。'},
  {id:'lm17',name:'祈求者·卡尔',rank:'legend',cat:'monster',source:'刀塔2',elements:[],desc:'能操控火、冰、雷三种元素的古老法师。元素三合一，拥有无穷无尽的法术组合，是战场上的终极多面手。'},
  {id:'lm18',name:'暗影之王·卡尔萨斯',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'死亡颂唱者，死亡的化身。他宣告死亡，受害者便无法逃脱。被击杀后依然能在战场上继续输出。'},
  {id:'lm19',name:'虚空先知·马尔扎哈',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'来自虚空的预言者，召唤虚空生物作战。他的幻象让敌人迷失在虚无之中，是精神控制的终极大师。'},
  {id:'lm20',name:'深渊巨口·克格莫',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'来自虚空的生化异形，嘴巴比身体还大。真实伤害的生化弹幕能穿透一切护甲，是毁灭的代名词。'},
  {id:'lm21',name:'诺克萨斯之手·德莱厄斯',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'诺克萨斯的刑场刽子手，手持巨斧。德莱厄斯之名意味着恐惧，斧下亡魂无数，是战场上的绞肉机。'},
  {id:'lm22',name:'正义巨像·加里奥',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'由魔法雕像觉醒的石像守护者。为了守护而牺牲自我，德玛西亚最坚固的盾牌。嘲讽开启时如铜墙铁壁。'},
  {id:'lm23',name:'黑暗之女·安妮',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'外表是可爱的小女孩，内心是操控火焰与黑暗的恐怖存在。她的泰迪熊"提伯斯"是一头真正的地狱之熊。'},
  {id:'lm24',name:'冰晶凤凰·艾尼维亚',rank:'legend',cat:'monster',source:'英雄联盟',elements:[],desc:'永生不死的冰霜神鸟，在弗雷尔卓德的雪原上翱翔。她的冰墙能封锁战场，她的复活能让敌人绝望。'},
  {id:'m01',name:'哥布林',rank:'c',cat:'monster',source:'原创',elements:[],desc:'最常见的小型绿皮怪物，贪婪、狡猾但胆小。它们成群结队出没，虽然单个不足为惧，但数量众多时会变得危险。'},
  {id:'m02',name:'克尔苏加德',rank:'s',cat:'monster',source:'魔兽世界',elements:[],desc:'巫妖王麾下最强大的亡灵法师，不死军团的精神领袖。生前是达拉然的大法师，死后成为纳克萨玛斯的主宰，智慧与力量同样深不可测。'},
  {id:'m03',name:'迪亚波罗',rank:'ss',cat:'monster',source:'暗黑破坏神',elements:[],desc:'恐惧之王，庇护之地的七大魔王之一。他能窥见人心深处的恐惧，并将其具象化。无数次被封印，又无数次重生，他的阴影笼罩整个人类世界。'},
  {id:'m04',name:'巴尔',rank:'ss',cat:'monster',source:'暗黑破坏神',elements:[],desc:'毁灭之王，迪亚波罗的兄弟，意图毁灭一切创造之物。他的存在本身就是为了终结，所经之处只剩废墟。在世界之石神殿与英雄决战。'},
  {id:'m05',name:'墨菲斯托',rank:'ss',cat:'monster',source:'暗黑破坏神',elements:[],desc:'憎恨之王，善于利用人类的贪婪与欲望。他的力量在于腐蚀人心，让英雄成为恶魔的傀儡。在崔凡克被囚禁千年，却依然操控着人间的阴谋。'},
  {id:'m06',name:'拉格纳罗斯',rank:'ss',cat:'monster',source:'魔兽世界',elements:[],desc:'火焰领主，元素领主的古老成员，被泰坦封印在熔火之心深处。他的觉醒意味着火山喷发与无尽烈焰。上古之神的手下最强者之一。'},
  {id:'m07',name:'阿克蒙德',rank:'s',cat:'monster',source:'魔兽世界',elements:[],desc:'燃烧军团副官，艾泽拉斯最恐怖的入侵者之一。在海加尔山之战中被世界之树的力量炸碎。他的邪能魔法足以毁灭整个王国。'},
  {id:'m08',name:'基尔加丹',rank:'s',cat:'monster',source:'魔兽世界',elements:[],desc:'欺诈者，燃烧军团的战略大师，策划了兽人入侵艾泽拉斯的阴谋。他的智慧比力量更可怕。曾是维伦的挚友，如今是不死不休的死敌。'},
  {id:'m09',name:'戒灵',rank:'ss',cat:'monster',source:'指环王',elements:[],desc:'九名被至尊魔戒腐蚀的幽灵骑士，永世游荡在中土大地。他们追杀魔戒持有者至天涯海角，永不休息。索伦最忠诚的仆从，也是最恐怖的追猎者。'},
  {id:'m10',name:'尸罗',rank:'ss',cat:'monster',source:'指环王',elements:[],desc:'索伦的巨型蜘蛛宠物，曾吞噬过无数精灵与人类，在奇力巴德洞穴中等待猎物。她的毒液能麻痹任何生物，甚至连至尊魔戒持有者都差点成为她的美餐。'},
  {id:'m11',name:'比蒙巨兽',rank:'ss',cat:'monster',source:'英雄无敌',elements:[],desc:'传说中能撕裂巨龙的巨型生物，陆战无敌。它的体型如山岳，每一步都引发地震。地下世界的霸主，没有任何地面部队能正面击败它。'},
  {id:'m12',name:'鬼龙',rank:'ss',cat:'monster',source:'英雄无敌',elements:[],desc:'以死亡魔法控制的龙族幽灵，无惧死亡。它的龙息是冷冻的死灵之气，能瞬间冻结灵魂。墓地阵营的终极单位。'},
  {id:'m13',name:'超梦',rank:'legend',cat:'monster',source:'宠物小精灵',elements:[],desc:'由梦幻的基因改造而成的究极宝可梦，拥有最强大的精神力量。它一直在寻找自己存在的意义，是人造生命的巅峰之作。'},
  {id:'m14',name:'裂空座',rank:'legend',cat:'monster',source:'宠物小精灵',elements:[],desc:'天空的霸主，守护臭氧层的传说宝可梦。当固拉多与盖欧卡战斗时，它会降临平息争端。 Mega进化后实力足以对抗神兽。'},
  {id:'m15',name:'固拉多',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'大地的创造者，远古时期与盖欧卡争夺世界。沉睡在岩浆之中，觉醒时会让大地干涸。原始回归时威力足以改变地貌。'},
  {id:'m16',name:'盖欧卡',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'海洋的创造者，远古时期与固拉多争夺世界。沉睡在深海之中，觉醒时会引发滔天海啸。原始回归时威力足以淹没大陆。'},
  {id:'m17',name:'奥妮克希亚',rank:'a',cat:'monster',source:'魔兽世界',elements:[],desc:'黑龙公主，化作人形潜伏在暴风城多年，策划了无数阴谋。她的巢穴布满焦灼的骨头与灰烬，能喷吐毁灭性的黑焰。'},
  {id:'m18',name:'奈法利安',rank:'a',cat:'monster',source:'魔兽世界',elements:[],desc:'死亡之翼之子，黑翼之巢的主人。他进行着可怕的龙族实验，创造出畸形的龙人与彩龙奥妮克希亚的兄长。'},
  {id:'m19',name:'都瑞尔',rank:'a',cat:'monster',source:'暗黑破坏神',elements:[],desc:'痛苦之王，崔凡克的守卫。巨大的甲虫形态地狱领主，能瞬间击碎游侠的防御，他的巢穴充满剧毒粘液。'},
  {id:'m20',name:'安达莉尔',rank:'a',cat:'monster',source:'暗黑破坏神',elements:[],desc:'痛苦女王，以甜美歌声诱惑灵魂。她的巢穴充满毒雾与白骨，是魔王中最善于诱惑人类的一位。'},
  {id:'m21',name:'座狼',rank:'a',cat:'monster',source:'指环王',elements:[],desc:'半兽人的巨大战狼坐骑，拥有钢铁般的利爪与血红的双眼。在夜色中追踪猎物，嗅觉灵敏，从不放弃猎物。'},
  {id:'m22',name:'食人魔',rank:'a',cat:'monster',source:'英雄无敌',elements:[],desc:'拥有两个头颅的巨型战士，力量惊人但智力低下。经常被雇佣为攻城先锋，一击足以粉碎城门。'},
  {id:'m23',name:'梦幻',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'传说中能变身成任何宝可梦的幻之宝可梦。极少被人看见，据说它的基因存在于每一个宝可梦体内，是所有宝可梦的始祖。'},
  {id:'m24',name:'班基拉斯',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'铠甲暴龙宝可梦，拥有毁灭山脉的力量。暴躁易怒，领地意识极强，Mega进化后实力堪比神兽。'},
  {id:'m25',name:'快龙',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'海之使者，能在16小时内绕地球一圈。外表可爱但实力强大，是许多训练家的梦想，性格温顺却无比忠诚。'},
  {id:'m26',name:'暴鲤龙',rank:'a',cat:'monster',source:'宠物小精灵',elements:[],desc:'当鲤鱼王经历了艰苦的修炼后，进化成的破坏之神。愤怒时会引发海啸，Mega进化后更能变为暗黑形态。'},
  {id:'m27',name:'冰霜巨龙',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'被亡灵法师复活的远古冰龙，龙息是冷冻的死灵之息，能将活人瞬间冻成冰雕。辛德拉苟萨是其中最著名的一位。'},
  {id:'m28',name:'深渊领主',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'燃烧军团中的巨人族，每一位都是毁灭的化身，挥舞着燃烧的巨斧。玛诺洛斯是最强大的深渊领主。'},
  {id:'m29',name:'石像鬼',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'被诅咒的石头生物，白天石化休眠，夜晚苏醒猎食。钟楼与古堡的常客，天灾军团的前线单位。'},
  {id:'m30',name:'堕落天使',rank:'c',cat:'monster',source:'暗黑破坏神',elements:[],desc:'从天界坠落的堕神，背负双翼的黑暗战士。手持黑暗之剑，猎杀光明使者，是地狱中最悲剧的存在。'},
  {id:'m31',name:'骨龙',rank:'c',cat:'monster',source:'英雄无敌',elements:[],desc:'由巨龙骨架复活的亡灵生物，虽然没有生命但依然凶猛无比，龙息是腐蚀灵魂的死灵之气。'},
  {id:'m32',name:'喷火龙',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'小火龙的最终进化形态，火焰能融化岩石，是训练家最向往的宝可梦之一。性格高傲但忠诚。'},
  {id:'m33',name:'水箭龟',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'杰尼龟的最终进化，背上的水炮能喷射高压水柱，精准打击敌人。冷静沉着，是最可靠的御三家之一。'},
  {id:'m34',name:'妙蛙花',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'妙蛙种子的最终进化，背上的巨大花朵能吸收阳光释放强力阳光射线。温和稳重，是最古老的御三家。'},
  {id:'m35',name:'雷丘',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'皮卡丘使用雷之石进化而来，电力更强但速度稍慢，尾巴能当避雷针。阿罗拉形态是电/超能双属性。'},
  {id:'m36',name:'火焰鸟',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'传说中的火焰宝可梦，翅膀上燃烧着永不熄灭的圣焰。看到它的人会获得永恒的好运。伽勒尔形态变为恶/飞行。'},
  {id:'m37',name:'史莱姆',rank:'c',cat:'monster',source:'勇者斗恶龙',elements:[],desc:'最经典的RPG小怪，果冻状的身体Q弹可爱，却能一口吞下冒险者。击败后常掉落小量金币。有多种颜色变种。'},
  {id:'m38',name:'金属史莱姆',rank:'c',cat:'monster',source:'勇者斗恶龙',elements:[],desc:'史莱姆的稀有变种，身体金属化，防御极高但HP只有1。逃跑速度快，但击杀后经验值惊人。'},
  {id:'m39',name:'哥布林',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'贪婪狡诈的小型人形生物，喜欢设陷阱和偷窃。部落中有专门的哥布林工程师，贩卖各种"靠谱"的发明。'},
  {id:'m40',name:'霍布哥布林',rank:'c',cat:'monster',source:'指环王',elements:[],desc:'哥布林的强壮变种，体型更大，力量更强。作为哥布林军队的精英单位，手持精制武器。'},
  {id:'m41',name:'野猪人',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'半人半猪的游牧民族，性格粗暴但讲究荣誉。雷霆崖以南的贫瘠之地常见它们的部落。刺脊氏族最著名。'},
  {id:'m42',name:'狗头人',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'蜡烛永远不会熄灭的矿工种族，对闪闪发光的矿石有病态的执着。常被用作矿坑守卫，崇拜龙族。'},
  {id:'m43',name:'鱼人',rank:'c',cat:'monster',source:'魔兽世界',elements:[],desc:'海岸线上令人头疼的种族，发出刺耳的"哇啦啦"叫声。新手冒险者的噩梦，数量众多且报复心强。'},
  {id:'m44',name:'骷髅兵',rank:'c',cat:'monster',source:'暗黑破坏神',elements:[],desc:'亡灵法师用死亡魔法复活的骨架战士，数量众多但单体很弱。最基础的亡灵单位，只有基础战斗本能。'},
  {id:'m45',name:'僵尸',rank:'c',cat:'monster',source:'暗黑破坏神',elements:[],desc:'被诅咒的不死生物，行动迟缓但不知疲倦。被咬伤后可能感染变成同类，尸体堆积处常见。'},
  {id:'m46',name:'沉沦魔',rank:'c',cat:'monster',source:'暗黑破坏神',elements:[],desc:'地狱的小恶魔，喜欢用火球攻击。死亡时会复活同伴，必须先杀召唤者。它们害怕时会逃跑。'},
  {id:'m47',name:'穴居者',rank:'c',cat:'monster',source:'上古卷轴',elements:[],desc:'生活在地下洞穴的原始生物，皮肤苍白，眼睛退化，靠听觉捕猎。部落制社会，会用简单武器。'},
  {id:'m48',name:'狼人',rank:'c',cat:'monster',source:'上古卷轴',elements:[],desc:'被诅咒变成半狼形态的人类，满月时会失控。银制武器对它们有特效。天际省的常见威胁。'},
  {id:'m49',name:'小绿皮',rank:'c',cat:'monster',source:'英雄无敌',elements:[],desc:'最基础的近战单位，虽然弱小但数量庞大，常作为炮灰冲锋在前。升级后变为高级哥布林。'},
  {id:'m50',name:'骷髅弓箭手',rank:'c',cat:'monster',source:'英雄无敌',elements:[],desc:'复活后的骷髅弓手，保留了生前射术。箭矢是蚀骨的黑暗魔法，数量多时极为致命。'},
  {id:'m51',name:'皮皮',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'妖精属性宝可梦，外表可爱但实力不弱。皮卡丘的好朋友，能学会很多辅助技能。是最早出现的宝可梦之一。'},
  {id:'m52',name:'波波',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'常见的小鸟宝可梦，训练家常从它开始培养飞行系。性格温顺，容易驯服。进化为比比鸟再到比雕。'},
  {id:'m53',name:'小拉达',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'最常见的小老鼠宝可梦，到处都是。繁殖力强，是新手训练家的主要对手。阿罗拉形态变为恶/一般。'},
  {id:'m54',name:'绿毛虫',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'虫系宝可梦的起点，进化线简单但承载着无数训练家的梦想——有朝一日成为美丽的巴大蝶。'},
  {id:'m55',name:'鲤鱼王',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'被称为最弱的宝可梦，只会水溅跃。但若能坚持培养，终将进化为恐怖的暴鲤龙。永远不要放弃它。'},
  {id:'m56',name:'走路草',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'白天埋在土里，夜晚行走。种子在头上，不知何时能进化成美丽的霸王花或臭臭花。'},
  {id:'m57',name:'独角虫',rank:'b',cat:'monster',source:'宠物小精灵',elements:[],desc:'橙色的虫宝宝可梦，头上的毒针是主要武器。目标是进化成威猛的大针蜂。'},
  {id:'m58',name:'半兽人',rank:'b',cat:'monster',source:'指环王',elements:[],desc:'萨鲁曼培育的改良兽人，体格魁梧，能经受阳光。是魔多大军的主力，数量以万计。'},
  {id:'m59',name:'强兽人',rank:'b',cat:'monster',source:'指环王',elements:[],desc:'半兽人中的精锐，皮肤黝黑如铁，力量惊人。手持重弩，是攻城的主力，能正面对抗人类骑士。'},
  {id:'m60',name:'烂泥怪',rank:'b',cat:'monster',source:'勇者斗恶龙',elements:[],desc:'剧毒的粘液怪物，碰触就会中毒。在潮湿的洞穴里缓慢蠕动，分解一切有机物。'},
  {id:'m61',name:'飞行史莱姆',rank:'b',cat:'monster',source:'勇者斗恶龙',elements:[],desc:'史莱姆的变种，长出了小翅膀。能从空中俯冲攻击，比普通史莱姆难对付。'},
  {id:'m62',name:'小蜘蛛',rank:'b',cat:'monster',source:'魔兽世界',elements:[],desc:'森林中最常见的小型蜘蛛，有毒但威胁不大。数量多时仍需小心。'},
  {id:'m63',name:'野狼',rank:'b',cat:'monster',source:'魔兽世界',elements:[],desc:'杜隆塔尔的草原狼，成群结队出没。虽然只是普通野兽，但对落单的旅人仍是威胁。'},
  {id:'m64',name:'鸭嘴火龙',rank:'b',cat:'monster',source:'宠物小精灵',elements:[],desc:'生活在火山的鸭嘴兽宝可梦，嘴巴能喷射火焰。进化后是强大的鸭嘴焰龙。'},
  {id:'m65',name:'蚊香蝌蚪',rank:'c',cat:'monster',source:'宠物小精灵',elements:[],desc:'蝌蚪宝可梦，肚子的旋涡图案很可爱。进化后成为强力的蚊香君再到蚊香泳士。'},
  {id:'m66',name:'森林强盗',rank:'c',cat:'monster',source:'原创',elements:[],desc:'在森林道路上打劫的小喽啰，装备简陋但人数众多，是新手冒险者的第一个敌人。'},
  {id:'m67',name:'山贼',rank:'c',cat:'monster',source:'原创',elements:[],desc:'盘踞在山道上的山贼，比森林强盗更凶悍一点，手里拿着生锈的砍刀。'},
  {id:'m68',name:'哥布林',rank:'c',cat:'monster',source:'原创',elements:[],desc:'矮小的绿皮生物，贪婪狡猾，喜欢偷东西，成群结队出现。'},
  {id:'m69',name:'地精',rank:'c',cat:'monster',source:'原创',elements:[],desc:'比哥布林更矮更丑，擅长挖掘地道和设置陷阱，矿坑中常见。'},
  {id:'m70',name:'史莱姆',rank:'c',cat:'monster',source:'原创',elements:[],desc:'最基础的怪物，一团软软的黏液，移动缓慢，新手练手的最佳选择。'},
  {id:'m71',name:'小恶魔',rank:'c',cat:'monster',source:'原创',elements:[],desc:'地狱的低级恶魔，长着蝙蝠翅膀和小角，会喷吐小火球。'},
  {id:'m72',name:'骷髅兵',rank:'c',cat:'monster',source:'原创',elements:[],desc:'被亡灵法师复活的骷髅，拿着腐朽的武器，在古墓中游荡。'},
  {id:'m73',name:'僵尸',rank:'c',cat:'monster',source:'原创',elements:[],desc:'行动缓慢但力大无穷的不死生物，被它咬到会感染尸毒。'},
  {id:'m74',name:'树精',rank:'b',cat:'monster',source:'原创',elements:[],desc:'森林中的古老精灵，与树木融为一体，会用藤蔓缠绕敌人。'},
  {id:'m75',name:'树人',rank:'b',cat:'monster',source:'原创',elements:[],desc:'觉醒的古老巨树，是森林的守护者，力量与树木根系相连。'},
  {id:'m76',name:'狼人',rank:'b',cat:'monster',source:'原创',elements:[],desc:'月圆之夜会变身的人类，平时看起来普通，变身后狂暴无比。'},
  {id:'m77',name:'巨型蜘蛛',rank:'c',cat:'monster',source:'原创',elements:[],desc:'洞穴中结网的大型蜘蛛，毒液能麻痹猎物，喜欢在黑暗中伏击。'},
  {id:'m78',name:'巨型蝎子',rank:'c',cat:'monster',source:'原创',elements:[],desc:'沙漠中的巨型蝎子，毒刺能致命，外壳坚硬如铁。'},
  {id:'m79',name:'狼群',rank:'c',cat:'monster',source:'原创',elements:[],desc:'成群结队的野狼，配合默契，领头的狼王更加狡猾。'},
  {id:'m80',name:'熊',rank:'c',cat:'monster',source:'原创',elements:[],desc:'森林中的巨熊，力大无穷，被激怒后非常可怕。'},
  {id:'m81',name:'野猪',rank:'c',cat:'monster',source:'原创',elements:[],desc:'凶猛的野猪，横冲直撞，獠牙能刺穿铠甲。'},
  {id:'m82',name:'巨蟒',rank:'b',cat:'monster',source:'原创',elements:[],desc:'沼泽中的巨型蟒蛇，能将猎物缠绕窒息。'},
  {id:'m83',name:'巨型蝙蝠',rank:'c',cat:'monster',source:'原创',elements:[],desc:'洞穴中的巨型蝙蝠，超声波能眩晕敌人，夜间活动。'},
  {id:'m84',name:'石像鬼',rank:'b',cat:'monster',source:'原创',elements:[],desc:'白天是石像，夜晚苏醒的守卫，身体坚硬如岩石。'},
  {id:'m85',name:'幽灵',rank:'b',cat:'monster',source:'原创',elements:[],desc:'徘徊在死地的怨灵，能穿透墙壁，攻击灵魂。'},
  {id:'m86',name:'食尸鬼',rank:'b',cat:'monster',source:'原创',elements:[],desc:'以尸体为食的丑恶生物，在墓地中出没。'},
  {id:'m87',name:'地精斥候',rank:'c',cat:'monster',source:'原创',elements:[],desc:'地精部落的侦察兵，速度快，擅长逃跑和报信。'},
  {id:'m88',name:'哥布林战士',rank:'c',cat:'monster',source:'原创',elements:[],desc:'哥布林中的战士，拿着破烂的武器，比普通哥布林能打一点。'},
  {id:'m89',name:'哥布林萨满',rank:'c',cat:'monster',source:'原创',elements:[],desc:'哥布林部落的祭司，会一些简单的黑暗魔法。'},
  {id:'m90',name:'狗头人',rank:'c',cat:'monster',source:'原创',elements:[],desc:'长着狗头的矮小生物，胆小但喜欢欺负弱小，崇拜龙。'},
  {id:'m91',name:'狗头人矿工',rank:'c',cat:'monster',source:'原创',elements:[],desc:'狗头人中的矿工，负责挖掘金矿和宝石。'},
  {id:'m92',name:'半兽人',rank:'b',cat:'monster',source:'原创',elements:[],desc:'兽人与人类的混血，比人类强壮，比兽人聪明。'},
  {id:'m93',name:'半兽人战士',rank:'b',cat:'monster',source:'原创',elements:[],desc:'半兽人中的精锐战士，装备精良，战斗经验丰富。'},
  {id:'m94',name:'半兽人萨满',rank:'b',cat:'monster',source:'原创',elements:[],desc:'半兽人部落的大祭司，掌握强大的黑暗魔法。'},
  {id:'m95',name:'强盗头目',rank:'b',cat:'monster',source:'原创',elements:[],desc:'强盗团伙的首领，比普通强盗更强，手里有把好刀。'},
  {id:'m96',name:'山贼大王',rank:'b',cat:'monster',source:'原创',elements:[],desc:'山贼山寨的大王，武艺高强，是一方恶霸。'},
  {id:'m97',name:'小恶魔仆从',rank:'c',cat:'monster',source:'原创',elements:[],desc:'侍奉高阶恶魔的小恶魔，负责打杂和传令。'},
  {id:'m98',name:'恶魔卫士',rank:'b',cat:'monster',source:'原创',elements:[],desc:'恶魔领主的卫士，比小恶魔强大很多，装备地狱铠甲。'},
  {id:'m99',name:'火焰小鬼',rank:'c',cat:'monster',source:'原创',elements:[],desc:'浑身燃烧的小恶魔，喜欢玩火，能引爆易燃物。'},
  {id:'m100',name:'冰霜小鬼',rank:'c',cat:'monster',source:'原创',elements:[],desc:'来自地狱冰冷深渊的小鬼，能冻结敌人的血液。'},
  {id:'h01',name:'阿尔萨斯',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'洛丹伦王子，从圣骑士堕落为死亡骑士，最终成为巫妖王。他的悲剧在于对拯救的执念，最终成为毁灭本身。霜之哀伤是他命运的起点与终点。'},
  {id:'h02',name:'萨尔',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'部落最伟大的领袖，从奴隶成长为部落大酋长。他的名字意为"拯救"，象征着兽人的救赎之路。元素萨满的力量与智慧同样深不可测。'},
  {id:'h03',name:'希尔瓦娜斯',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'被遗忘者的女王，曾经的高等精灵游侠将军。风行者家族的骄傲，死亡无法束缚她的意志。弑君之箭终结了阿尔萨斯的命运。'},
  {id:'h04',name:'伊利丹',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'背叛者，囚禁了一万年依然不屈。他的双翼蕴含邪能，双眼燃烧着魔火。"你们这是自寻死路！"是他对基尔加丹的挑战。'},
  {id:'h05',name:'甘道夫',rank:'ss',cat:'hero',source:'指环王',elements:[],desc:'灰袍巫师，为对抗索伦穿越中土世界的迈雅。他的智慧与力量同样深不可测，从灰袍到白袍的蜕变象征着更强大的使命。'},
  {id:'h06',name:'阿拉贡',rank:'ss',cat:'hero',source:'指环王',elements:[],desc:'埃莱萨王，游侠，重建中土秩序的王。他的血脉可追溯至努门诺尔，注定要重拾人类的荣耀。纳西尔圣剑在他手中重铸。'},
  {id:'h07',name:'泰兰德',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'暗夜精灵的大祭司，月之女神艾露恩的代言人。她的银月之光永不熄灭，守护着卡利姆多的森林。玛法里奥的挚爱。'},
  {id:'h08',name:'吉安娜',rank:'ss',cat:'hero',source:'魔兽世界',elements:[],desc:'库尔提拉斯的公主，达拉然的前任领袖。她是艾泽拉斯最强大的法师之一，从和平主义者到复仇者的转变令人唏嘘。'},
  {id:'h09',name:'莱戈拉斯',rank:'ss',cat:'hero',source:'指环王',elements:[],desc:'幽暗密林的精灵王子，神射手。他的箭从不落空，与矮人吉姆利形成意想不到的友谊。护戒远征队的核心成员。'},
  {id:'h10',name:'李奥瑞克',rank:'ss',cat:'hero',source:'暗黑破坏神',elements:[],desc:'曾经的圣君王，被迪亚波罗的诅咒腐化。现在以骷髅王之姿在崔凡克地下城复活，手持传奇战锤。'},
  {id:'h11',name:'死雾',rank:'ss',cat:'hero',source:'英雄无敌',elements:[],desc:'死亡骑士英雄，骑着梦魇兽，在战场上挥舞霜之哀伤之影。所过之处，生机凋零。墓地阵营的传奇英雄。'},
  {id:'h12',name:'小智',rank:'c',cat:'hero',source:'宠物小精灵',elements:[],desc:'来自真新镇的热血训练家，目标是成为宝可梦大师。皮卡丘是他最忠实的伙伴，虽然屡败屡战，但从不放弃梦想。'},
  {id:'h13',name:'小茂',rank:'a',cat:'hero',source:'宠物小精灵',elements:[],desc:'大木博士的孙子，小智的宿敌兼挚友。冷静聪明的训练家，喷火龙是他的王牌。后来成为研究员。'},
  {id:'h14',name:'红龙',rank:'ss',cat:'hero',source:'原创',elements:[],desc:'亚特兰大要塞的城主与废土行者联盟的盟主。传闻他的血脉中流淌着上古红龙的基因，双眼能在黑暗中发出猩红的光芒。拥有操控血液与生命力的天赋异能——他能控制敌人的血液流动造成内伤，也能用自己的血液注入伤者体内修复创伤。而最令人敬畏的能力，是"血之净化"：他能将血液中的毒素与邪能强行剥离，哪怕那毒素来自深渊恶魔的腐蚀。霜狼氏族中那些沾染了恶魔之血的战士，正是被他的血之净化所拯救。他的宠物是一只名为"虚空瑶"的灵兽——通体漆黑如墨，能在虚实之间穿梭，以负面情绪为食。'},
  {id:'h15',name:'霜刃·杜隆坦',rank:'s',cat:'hero',source:'原创',elements:[],desc:'霜狼氏族的酋长，背负着恶魔之血的诅咒。在红龙的"血之净化"下暂时压制了体内的邪能，但永远无法彻底摆脱——那诅咒会在他情绪激动时再次苏醒。他发誓要找到彻底清除恶魔之血的方法，既是为了自己，也是为了所有被诅咒的族人。'},
  {id:'h16',name:'血疗师·莉莉安',rank:'ss',cat:'hero',source:'原创',elements:[],desc:'红龙的副手与侍从，学会了用血液治病的术法。她能用自己的血液注入伤者体内加速愈合，也能在战场上为濒死的战士续命。但在私下里，她始终害怕一件事——如果红龙需要她的血液，她无法拒绝。'},
  {id:'c01',name:'暴风城',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'人类王国艾泽拉斯的首都，联盟的核心枢纽。雄伟的白银之臂城墙守护着这座永不陷落的光明之城，大教堂的钟声每日回荡，瓦里安国王的雕像俯瞰港湾。'},
  {id:'c02',name:'奥格瑞玛',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'兽人主城，由萨尔建立在杜隆塔尔干旱的峡谷中。整座城市从岩石中开凿而成，展现着部落的力量与荣耀。萨尔、加尔鲁什都曾在此统御部落。'},
  {id:'c03',name:'达拉然',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'飘浮的魔法之城，肯瑞托议会的所在地。整座城市悬浮在云端，无数塔楼与奥术阵列闪烁着紫色的光芒，是艾泽拉斯魔法研究的心脏。'},
  {id:'c04',name:'银月城',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'血精灵的都城，曾经的高等精灵王国首都。耀眼的光芒照耀着永生的精灵子民，浮空的太阳井散发着神圣能量，是东部王国最华丽的城市。'},
  {id:'c05',name:'米纳斯提里斯',rank:'ss',cat:'city',source:'指环王',elements:[],desc:'刚铎的白城，人类联盟最后的堡垒。七层城墙层层递进，最高处是刚铎之塔，俯瞰着整个帕兰诺平原。迪耐瑟的疯狂与阿拉贡的复兴在此交织。'},
  {id:'c06',name:'洛丝萝莲',rank:'ss',cat:'city',source:'指环王',elements:[],desc:'精灵女王的领地，整片森林都是黄金与银叶的梦境。凯兰崔尔的魔法让这里永驻春天的荣光，是中土最神秘的精灵国度。'},
  {id:'c07',name:'史盖利格',rank:'d',cat:'city',source:'艾尔登法环',elements:[],desc:'交界地的魔法学院，雷娜菈女王统治的浮空之城。满月的倒影在湖泊中永恒旋转，辉石魔法在此诞生与传承。'},
  {id:'c08',name:'瑞文戴尔',rank:'d',cat:'city',source:'暗黑破坏神',elements:[],desc:'崔凡克的诅咒神殿，三大魔王封印之地。扭曲的钟楼与腐烂的花园，空气中弥漫着硫磺与死亡气息，是庇护之地最危险的区域。'},
  {id:'c09',name:'埃雷萨拉斯',rank:'ss',cat:'city',source:'英雄无敌',elements:[],desc:'精灵与龙族共治的神秘都市，魔法塔林立。龙骑士在云端巡逻，保护着学院的知识宝库，是塔楼阵营的核心城市。'},
  {id:'c10',name:'铁炉堡',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'矮人的地下都城，从丹莫罗的山脉中开凿而成。大熔炉的火焰永不熄灭，是锻造之都的心脏。麦格尼国王化为钻石后，议会共同执政。'},
  {id:'c11',name:'幽暗城',rank:'ss',cat:'city',source:'魔兽世界',elements:[],desc:'被遗忘者的首都，建在洛丹伦废墟下方。绿色的炼金蒸汽弥漫，死亡与科学的诡异结合，是希尔瓦娜斯女王的大本营。'},
  {id:'c12',name:'刚达巴',rank:'ss',cat:'city',source:'指环王',elements:[],desc:'矮人都城，由古老矮人在孤独山中建造。大厅宏伟如殿堂，曾遭史矛革霸占。巴林远征队曾在此全军覆没。'},
  {id:'c13',name:'真新镇',rank:'c',cat:'city',source:'宠物小精灵',elements:[],desc:'许多训练家的出发地，安静祥和的小镇。小智、小茂、小遥都从这里开始冒险，是关都地区的起点。'},
  {id:'c14',name:'常磐市',rank:'c',cat:'city',source:'宠物小精灵',elements:[],desc:'靠近常磐森林的城市，道馆馆主是强大的坂木。也是前往石英高原参加联盟大赛的最后一站。'},
  {id:'c15',name:'夏尔',rank:'c',cat:'city',source:'指环王',elements:[],desc:'霍比特人的家园，宁静的田园村庄。圆门的洞穴住宅掩映在绿丘之间，比尔博和弗罗多的故事从这里开始。'},
  {id:'c16',name:'十字路口',rank:'c',cat:'city',source:'魔兽世界',elements:[],desc:'贫瘠之地的部落前哨站，商队与冒险者的必经之地。简陋的帐篷与篱笆围成的小营地，是新手区域的重要枢纽。'},
  {id:'c17',name:'布里',rank:'c',cat:'city',source:'指环王',elements:[],desc:'人类与霍比特人混居的小镇，跃马旅店是冒险者的重要中转站。是夏尔以东最后的人类定居点。'},
  {id:'c18',name:'亚特兰大',rank:'legend',cat:'city',source:'原创',elements:[],desc:'重建于末世废土之上的科技要塞，以佐治亚理工学院古老的穹顶建筑为核心。巨型的净水塔与电磁防护屏障守护着最后的文明火种。统治者"红龙"以绝对的力量与冷酷的手段维护着要塞的秩序——他既是废土行者联盟的盟主，也是这片废土上最强的战士。传闻他的血脉中流淌着上古红龙的基因，令他拥有操控血液与生命力的天赋异能。'},
  {id:'s01',name:'星落',rank:'legend',cat:'skill',source:'魔兽世界',elements:['rock','dark'],desc:'大法师的终极法术，无数陨石从天而降，毁灭一切。卡德加用此技能在德拉诺之战中扭转战局，是艾泽拉斯最壮观的自然魔法之一。'},
  {id:'s02',name:'暗影烈焰',rank:'ss',cat:'skill',source:'魔兽世界',elements:['dark','fire'],desc:'死亡之翼的吐息，混合了暗影与火焰的恐怖力量。能融化泰坦的金属铠甲，是毁灭世界的禁忌魔法。'},
  {id:'s03',name:'时间倒流',rank:'legend',cat:'skill',source:'魔兽世界',elements:['psychic','dragon'],desc:'青铜龙守护者诺兹多姆的能力，可以回溯时间线。这是最强大的时间魔法，能改变历史本身。'},
  {id:'s04',name:'灵魂虹吸',rank:'legend',cat:'skill',source:'暗黑破坏神',elements:['dark','ghost'],desc:'死灵法师的招牌技能，从敌人身上夺取生命与灵魂。塔·拉夏用此技能封印了三大魔王。'},
  {id:'s05',name:'灰烬风暴',rank:'ss',cat:'skill',source:'暗黑破坏神',elements:['fire','dark'],desc:'死灵法师的终极技能，召唤席卷战场的灰烬风暴，焚烧一切生灵。'},
  {id:'s06',name:'元素风暴',rank:'ss',cat:'skill',source:'暗黑破坏神',elements:['fire','ice','electric'],desc:'同时召唤火焰、冰霜、雷电三系魔法元素风暴，是德鲁伊的终极形态。'},
  {id:'s07',name:'天照',rank:'legend',cat:'skill',source:'火影忍者',elements:['fire','light'],desc:'瞳术之一，召唤永不熄灭的黑色火焰吞噬一切。宇智波鼬的招牌忍术，只有施术者能将其熄灭。'},
  {id:'s08',name:'艾尔登流星',rank:'legend',cat:'skill',source:'艾尔登法环',elements:['dragon','psychic'],desc:'满月女王的禁忌魔法，召唤巨大的流星摧毁一切。是魔法剑士的终极奥义。'},
  {id:'s09',name:'链闪电',rank:'ss',cat:'skill',source:'暗黑破坏神',elements:['electric','dark'],desc:'电系魔法，电流在敌群中跳跃造成连锁伤害。索尔森的招牌法术，能同时打击多个目标。'},
  {id:'s10',name:'火焰强化',rank:'s',cat:'skill',source:'暗黑破坏神',elements:['fire'],desc:'将火焰之力注入武器，大幅提升物理伤害。战士们钟爱的增益魔法。'},
  {id:'s11',name:'骨牢',rank:'a',cat:'skill',source:'暗黑破坏神',elements:['ghost','ground'],desc:'从地面升起骨刺构成的牢笼，困住敌人。死灵法师的控制技能。'},
  {id:'s12',name:'白骨之魂',rank:'s',cat:'skill',source:'暗黑破坏神',elements:['ghost','dark'],desc:'召唤死者的灵魂为自己战斗，灵魂越多越强大。是死灵法师的核心技能。'},
  {id:'s13',name:'星火术',rank:'s',cat:'skill',source:'魔兽世界',elements:['fairy','fire'],desc:'德鲁伊的自然魔法，向目标投射灼热的星光能量。平衡德鲁伊的招牌技能。'},
  {id:'s14',name:'神圣干预',rank:'ss',cat:'skill',source:'魔兽世界',elements:['light','fairy'],desc:'圣骑士的终极技能，召唤圣光降临保护盟友。能在关键时刻挽救整个团队。'},
  {id:'s15',name:'雷霆一击',rank:'s',cat:'skill',source:'魔兽世界',elements:['electric','fighting'],desc:'战士的标志性技能，用雷霆之力重击地面，对周围敌人造成自然伤害并减速。'},
  {id:'s16',name:'黑暗波动',rank:'ss',cat:'skill',source:'暗黑破坏神',elements:['dark','ghost'],desc:'武僧的终极技能，以气功释放毁灭性的黑暗能量波。'},
  {id:'s17',name:'火球术',rank:'s',cat:'skill',source:'魔兽世界',elements:['fire'],desc:'最基础的火焰法术，向目标投射一个燃烧的火球。法师学徒的第一个攻击魔法。'},
  {id:'s18',name:'寒冰箭',rank:'s',cat:'skill',source:'魔兽世界',elements:['ice'],desc:'向目标发射寒冰箭，造成冰冻伤害并减缓其移动速度。冰霜法师的核心技能。'},
  {id:'s19',name:'闪电箭',rank:'s',cat:'skill',source:'魔兽世界',elements:['electric'],desc:'萨满的基础法术，向目标发射一道闪电。元素萨满的招牌技能。'},
  {id:'s20',name:'月火术',rank:'s',cat:'skill',source:'魔兽世界',elements:['fairy','fire'],desc:'德鲁伊的基础自然魔法，向目标投射月光能量。是持续伤害技能。'},
  {id:'s21',name:'毒击',rank:'a',cat:'skill',source:'宠物小精灵',elements:['poison'],desc:'毒系宝可梦的招牌技能，注入剧毒造成持续伤害。阿柏怪的必杀技。'},
  {id:'s22',name:'喷射火焰',rank:'a',cat:'skill',source:'宠物小精灵',elements:['fire'],desc:'火系宝可梦最强大的招式之一，喷射高温火焰。喷火龙、火焰鸡都能学会。'},
  {id:'s23',name:'十万伏特',rank:'a',cat:'skill',source:'宠物小精灵',elements:['electric'],desc:'电系宝可梦的经典招式，释放强力电击。皮卡丘的招牌技能。'},
  {id:'s24',name:'水炮',rank:'a',cat:'skill',source:'宠物小精灵',elements:['water'],desc:'水系宝可梦的强力招式，喷射高压水柱。虽然命中率低但威力巨大。'},
  {id:'s25',name:'撞击',rank:'c',cat:'skill',source:'宠物小精灵',elements:['normal'],desc:'最基础的物理攻击技能，用身体撞击敌人。几乎所有宝可梦都能学会。'},
  {id:'s26',name:'抓',rank:'c',cat:'skill',source:'宠物小精灵',elements:['normal'],desc:'用利爪攻击敌人，简单但实用的物理技能。喵喵的招牌招式。'},
  {id:'s27',name:'叫声',rank:'c',cat:'skill',source:'宠物小精灵',elements:['normal'],desc:'发出可爱的叫声降低敌人的攻击欲望。是最无害的技能。'},
  {id:'s28',name:'火花',rank:'b',cat:'skill',source:'宠物小精灵',elements:['fire'],desc:'小火龙的初始技能，喷射小型火焰。是成长中的火系宝可梦的基础招式。'},
  {id:'s29',name:'水枪',rank:'b',cat:'skill',source:'宠物小精灵',elements:['water'],desc:'杰尼龟的基础水系技能，喷射小型水流。威力不大但消耗低。'},
  {id:'s30',name:'藤鞭',rank:'a',cat:'skill',source:'宠物小精灵',elements:['grass'],desc:'妙蛙种子的招牌技能，用藤鞭攻击敌人。是草系宝可梦的基础招式。'},
  {id:'s31',name:'电击',rank:'b',cat:'skill',source:'宠物小精灵',elements:['electric'],desc:'皮卡丘的基础电系技能，释放小型电击。有一定概率麻痹敌人。'},
  {id:'s32',name:'格斗',rank:'b',cat:'skill',source:'宠物小精灵',elements:['fighting'],desc:'格斗系的基础招式，用拳脚攻击。腕力的招牌技能。'},
  {id:'s33',name:'冰冻之风',rank:'a',cat:'skill',source:'魔兽世界',elements:['ice','flying'],desc:'法师的基础冰霜技能，向锥形区域喷射寒风。能减缓多个敌人。'},
  {id:'s34',name:'暗影箭',rank:'a',cat:'skill',source:'魔兽世界',elements:['dark','ghost'],desc:'术士的基础暗影魔法，向目标发射暗影能量箭。是痛苦术士的核心技能。'},
  {id:'f01',name:'霜狼氏族',rank:'ss',cat:'faction',source:'魔兽世界',elements:[],desc:'德拉诺最古老的兽人氏族之一，由杜隆坦领导。格罗玛什是战后幸存的后裔，在艾泽拉斯重建霜狼氏族，族众数千人，以战吼闻名。'},
  {id:'f02',name:'钢铁部落',rank:'ss',cat:'faction',source:'魔兽世界',elements:[],desc:'由加尔鲁什·地狱咆哮在另一条时间线建立的兽人帝国，以钢铁与科技征服一切。机械化的战争机器横扫德拉诺，是最具侵略性的势力。'},
  {id:'f03',name:'洛丹伦联盟',rank:'ss',cat:'faction',source:'魔兽世界',elements:[],desc:'人类七王国在第二次战争时组成的同盟，以洛丹伦为核心对抗部落。泰瑞纳斯国王的领导力使联盟一度成为艾泽拉斯最强大的势力。'},
  {id:'f04',name:'暗影议会',rank:'ss',cat:'faction',source:'魔兽世界',elements:[],desc:'古尔丹建立的秘密术士组织，暗中操控部落的命运。成员全是最强大的术士与死亡骑士，是燃烧军团在艾泽拉斯的代理人。'},
  {id:'f05',name:'刚铎王国',rank:'ss',cat:'faction',source:'指环王',elements:[],desc:'努门诺尔人在中土建立的南方王国，米纳斯提里斯是其首都。从伊熙尔杜到阿拉贡，刚铎始终是对抗索伦的中坚力量。'},
  {id:'f06',name:'魔多帝国',rank:'ss',cat:'faction',source:'指环王',elements:[],desc:'黑暗魔君索伦的领地，整座帝国建立在火山与灰烬之上。无数兽人、强兽人、那兹古尔在此集结，是中土最恐怖的邪恶势力。'},
  {id:'f07',name:'法师议会',rank:'ss',cat:'faction',source:'暗黑破坏神',elements:[],desc:'赫拉迪姆兄弟会的继承者，守护着庇护之地免受地狱侵袭。成员全是精通魔法的大师，是对抗三大魔王的最后防线。'},
  {id:'f08',name:'废土行者联盟',rank:'ss',cat:'faction',source:'原创',elements:[],desc:'末世废土中幸存者的结盟，以亚特兰大科技要塞为核心。净水塔、电磁屏障、废土商路，是文明最后的守护者。'},
  {id:'f09',name:'塔楼学院',rank:'ss',cat:'faction',source:'英雄无敌',elements:[],desc:'精灵与龙族共同统治的魔法城邦，以知识与智慧为最高追求。龙骑士在天空巡逻，保护着学院的魔法宝库。'},
  {id:'f10',name:'白银之手骑士团',rank:'ss',cat:'faction',source:'魔兽世界',elements:[],desc:'乌瑟尔·光明使者建立的圣骑士团，是洛丹伦王国的守护者。圣光的力量在此传承，阿尔萨斯的背叛使骑士团分崩离析。'},
  {id:'f100',name:'暗影契约',rank:'legend',cat:'faction',source:'原创',elements:[],desc:'由堕落的法师、刺客与死灵术士组成的秘密结社，他们与暗影世界签订了永恒的契约，以灵魂为代价换取无尽的黑暗力量。他们的目标是将整个世界笼罩在永恒的夜幕之中。'},
  {id:'f101',name:'炎魔之手',rank:'legend',cat:'faction',source:'原创',elements:[],desc:'崇拜毁灭与烈焰的狂热宗教组织，他们相信只有通过焚烧一切，世界才能获得新生。炎魔之手的成员个个都是纵火狂魔，他们所过之处只剩焦土与灰烬。'},
  {id:'f102',name:'深渊之眼',rank:'legend',cat:'faction',source:'原创',elements:[],desc:'来自深海的神秘教派，他们膜拜沉睡在海底的旧日支配者。深渊之眼的信徒能够窥见宇宙的终极秘密，但代价是永远的疯狂。他们等待着群星归位的那一天，迎接他们的主人苏醒。'},
  {id:'f103',name:'钢铁王朝',rank:'ss',cat:'faction',source:'原创',elements:[],desc:'由机械与血肉结合的恐怖帝国，他们抛弃了人性，将灵魂注入冰冷的钢铁之中。钢铁王朝试图用机械统治一切有机生命，他们的口号是：血肉苦弱，机械永生。'},
  {id:'f104',name:'血色黄昏',rank:'ss',cat:'faction',source:'原创',elements:[],desc:'嗜血的吸血鬼与狼人组成的黑暗议会，他们以人类的鲜血为食，在月光下狩猎。血色黄昏认为自己是更高等的生命，人类只是他们的食物与玩物。'},
  {id:'f105',name:'混沌之种',rank:'s',cat:'faction',source:'原创',elements:[],desc:'散播混乱与疯狂的邪教组织，他们相信秩序是束缚，混沌才是自由。混沌之种的成员会使用各种手段颠覆政权，引发战争，让整个世界陷入无休止的混乱之中。'},
  {id:'f106',name:'虚空先锋',rank:'legend',cat:'faction',source:'原创',elements:[],desc:'来自虚空深处的先遣军团，他们是毁灭的使者，所经之处万物化为虚无。虚空先锋由虚空龙、虚空行者与虚空领主组成，他们的最终目标是吞噬整个物质世界。'},
  {id:'f107',name:'巫毒教团',rank:'ss',cat:'faction',source:'原创',elements:[],desc:'掌握诅咒与死灵术的黑暗教派，他们用活人献祭，召唤亡灵军团。巫毒教团的祭司能够降下可怕的诅咒，让人生不如死。他们的信仰是：死亡不是终结，而是奴役的开始。'},
  {id:'f108',name:'黑铁议会',rank:'s',cat:'faction',source:'原创',elements:[],desc:'由堕落的贵族、贪婪的商人与野心勃勃的将军组成的阴谋集团。黑铁议会在暗中操控政局，挑起战争，通过牺牲无数人的生命来攫取权力与财富。'},
  {id:'t01',name:'秘银锻造',rank:'s',cat:'talent',source:'原创',elements:['steel','fighting'],desc:'掌握秘银与龙焰的锻造秘法，武器有几率被注入超凡力量。'},
  {id:'t02',name:'龙焰血脉',rank:'ss',cat:'talent',source:'原创',elements:['fire','dragon'],desc:'远古巨龙的火焰在血脉中燃烧，赋予驾驭龙焰的天赋能力。'},
  {id:'t03',name:'霜狼之魂',rank:'ss',cat:'talent',source:'原创',elements:['ice','fighting'],desc:'霜狼氏族的古老传承，赋予驾驭寒霜与冰雪的本能。'},
  {id:'t04',name:'亡灵意志',rank:'ss',cat:'talent',source:'原创',elements:['dark','ghost'],desc:'死亡无法束缚的意志，近战中带有腐蚀性的死亡气息。'},
  {id:'t05',name:'圣光庇护',rank:'ss',cat:'talent',source:'原创',elements:['light','fairy'],desc:'圣光的恩赐环绕周身，在危急时刻化为无形的守护。'},
  {id:'t06',name:'恶魔之眼',rank:'ss',cat:'talent',source:'原创',elements:['dark','psychic'],desc:'囚禁万年获得的邪恶之眼，能洞穿一切幻象与暗影。'},
  {id:'t07',name:'泰坦之力',rank:'legend',cat:'talent',source:'原创',elements:['steel','fighting'],desc:'泰坦血脉中流淌的原始神力，能撼动大地与苍穹。'},
  {id:'t08',name:'自然盟友',rank:'s',cat:'talent',source:'原创',elements:['grass','ground'],desc:'与大自然有着深刻的连接，植物与野兽愿意亲近并协助作战。'},
  {id:'t09',name:'月之恩赐',rank:'ss',cat:'talent',source:'原创',elements:['fairy','psychic'],desc:'月之女神的眷属，在月光照耀下拥有近乎神祇的力量。'},
  {id:'t10',name:'氪星之子',rank:'legend',cat:'talent',source:'原创',elements:['steel','light'],desc:'来自遥远星球的血脉，赋予超越凡人的肉体力量。'},
  {id:'t11',name:'自愈因子',rank:'ss',cat:'talent',source:'原创',elements:['normal','fairy'],desc:'身体拥有异常强大的再生能力，即使重伤也能快速愈合。'},
  {id:'t12',name:'龙裔',rank:'legend',cat:'talent',source:'原创',elements:['dragon','fire'],desc:'远古龙族的血脉传承，对龙族有着天然的感知与联系。'},
  {id:'t13',name:'大难不死',rank:'legend',cat:'talent',source:'原创',elements:['normal','fairy'],desc:'古老的爱的魔法在危急时刻显现，化作无形的护盾。'},
  {id:'t14',name:'龙语者',rank:'ss',cat:'talent',source:'原创',elements:['dragon','psychic'],desc:'坦格利安血脉的标志，拥有与龙沟通并驾驭龙火的古老天赋。'},
  {id:'t15',name:'月圆变身',rank:'ss',cat:'talent',source:'原创',elements:['dark','fighting'],desc:'月圆之夜的诅咒，在月光下化身为狂暴的巨狼。'},
  {id:'t16',name:'钢铁意志',rank:'s',cat:'talent',source:'原创',elements:['steel','fighting'],desc:'在无数次战斗中锤炼出的钢铁意志，意志薄弱者无法撼动其分毫。'},
  {id:'t17',name:'剑术宗师',rank:'s',cat:'talent',source:'原创',elements:['steel','fighting'],desc:'对剑道的毕生钻研，让每一剑都带有致命的精准与力量。'},
  {id:'t18',name:'雷电法王',rank:'s',cat:'talent',source:'原创',elements:['electric','psychic'],desc:'雷电的化身，电系魔法的极致运用者。'},
  {id:'t19',name:'火法真传',rank:'s',cat:'talent',source:'原创',elements:['fire','psychic'],desc:'火系魔法的真正传人，能将火焰发挥到极致。'},
  {id:'t20',name:'暗影箭雨',rank:'s',cat:'talent',source:'原创',elements:['dark','ghost'],desc:'暗影的操控者，能召唤无尽的暗影能量吞噬敌人。'},
  {id:'t21',name:'猎人之眼',rank:'s',cat:'talent',source:'原创',elements:['normal','psychic'],desc:'百发百中的神射手，能精准命中敌人最脆弱的地方。'},
  {id:'t22',name:'治疗结界',rank:'s',cat:'talent',source:'原创',elements:['fairy','light'],desc:'神圣的治疗魔法，能在治愈伤口的同时形成防护结界。'},
  {id:'t23',name:'元素统御',rank:'ss',cat:'talent',source:'原创',elements:['fire','ice','electric'],desc:'与元素之灵有着深刻的连接，能同时驾驭多种元素之力。'},
  {id:'t24',name:'奥术精通',rank:'ss',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'对奥术魔法有着极深的造诣，能以最小的代价施放强大的魔法。'},
  {id:'t25',name:'攻城意志',rank:'a',cat:'talent',source:'原创',elements:['steel','ground'],desc:'攻城战中的噩梦，专门用于摧毁坚固的防御工事。'},
  {id:'t26',name:'暴风城荣耀',rank:'s',cat:'talent',source:'原创',elements:['light','steel'],desc:'暴风城的光辉照耀联盟每一位战士，使协作作战的威力倍增。'},
  {id:'t27',name:'铁炉堡意志',rank:'s',cat:'talent',source:'原创',elements:['steel','ground'],desc:'大熔炉的火焰永不熄灭，赋予矮人锻造师超越凡人的铸炼天赋。'},
  {id:'t28',name:'达拉然秘法',rank:'s',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'肯瑞托的智慧环绕着每一位达拉然法师，使施法更加高效。'},
  {id:'t29',name:'银月灵弓',rank:'s',cat:'talent',source:'原创',elements:['fairy','steel'],desc:'太阳井的能量灌注箭矢，使每一箭都带有神圣的精灵之力。'},
  {id:'t30',name:'米纳斯防线',rank:'s',cat:'talent',source:'原创',elements:['steel','light'],desc:'七层城墙的防御智慧，让守卫者获得城墙的力量。'},
  {id:'t31',name:'幽暗密法',rank:'a',cat:'talent',source:'原创',elements:['dark','ghost'],desc:'被遗忘者的炼金与暗影魔法交织，赋予城市独特的腐蚀之力。'},
  {id:'t32',name:'洛丝萝莲庇护',rank:'a',cat:'talent',source:'原创',elements:['fairy','grass'],desc:'凯兰崔尔女王的魔法环绕全城，让森林之力眷顾每一位盟友。'},
  {id:'t33',name:'史盖利格满月',rank:'a',cat:'talent',source:'原创',elements:['psychic','dark'],desc:'满月倒影在雷亚柳湖中永恒旋转，赋予这座魔法学院无与伦比的月之力量。'},
  {id:'t34',name:'亚特兰大科技',rank:'a',cat:'talent',source:'原创',elements:['steel','electric'],desc:'废土科技的结晶，让幸存者的每一件发明都发挥最大效用。'},
  {id:'t35',name:'部落战魂',rank:'s',cat:'talent',source:'原创',elements:['fighting','fire'],desc:'部落的古老战魂附体，让战士在血战中越战越勇。'},
  {id:'t36',name:'联盟冲锋',rank:'a',cat:'talent',source:'原创',elements:['light','steel'],desc:'联盟的荣耀让战士们团结一心，共同冲锋时势不可挡。'},
  {id:'t37',name:'亡灵统御',rank:'a',cat:'talent',source:'原创',elements:['dark','ghost'],desc:'亡灵的主人在此，亡者听从号令，骸骨化为利刃。'},
  {id:'t38',name:'法师秘会',rank:'a',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'知识就是力量，法师议会的成员在学术切磋中不断提升。'},
  {id:'t39',name:'魔多征服',rank:'c',cat:'talent',source:'原创',elements:['dark','fire'],desc:'黑暗魔君的威压笼罩战场，令敌人闻风丧胆。'},
  {id:'t40',name:'虚空裂隙',rank:'c',cat:'talent',source:'原创',elements:['dark','psychic'],desc:'来自虚空深处的力量，能在现实中撕开通往虚无的裂隙。'},
  {id:'t41',name:'机械强化',rank:'c',cat:'talent',source:'原创',elements:['steel','electric'],desc:'血肉苦弱，机械永恒。钢铁王朝的每一员都经过机械改造。'},
  {id:'t42',name:'混沌播撒',rank:'c',cat:'talent',source:'原创',elements:['dark','fire'],desc:'混沌之种的信条，让秩序本身化为混乱的温床。'},
  {id:'t43',name:'巫毒诅咒',rank:'c',cat:'talent',source:'原创',elements:['poison','dark'],desc:'来自非洲原始崇拜的恐怖诅咒，能让敌人在痛苦中慢慢死去。'},
  {id:'t44',name:'狡诈闪避',rank:'b',cat:'talent',source:'原创',elements:['dark','normal'],desc:'狡诈是弱小者的生存之道，哥布林和地精最擅长在危险中寻找逃脱的机会。'},
  {id:'t45',name:'突袭优势',rank:'b',cat:'talent',source:'原创',elements:['fighting','normal'],desc:'喽啰们最擅长的战术——趁人不备时突然出手。'},
  {id:'t46',name:'亡灵体质',rank:'b',cat:'talent',source:'原创',elements:['ghost','poison'],desc:'死亡不是终结，而是另一种开始。亡灵单位即使倒下，也可能再次爬起。'},
  {id:'t47',name:'群体围攻',rank:'b',cat:'talent',source:'原创',elements:['fighting','dark'],desc:'狼群战术的核心——数量就是力量，配合让弱者也能放倒强者。'},
  {id:'t48',name:'两栖适应',rank:'b',cat:'talent',source:'原创',elements:['water','ground'],desc:'鱼人天生适应水陆两栖，无论在海边还是陆地都能战斗。'},
  {id:'t49',name:'根须缠绕',rank:'b',cat:'talent',source:'原创',elements:['grass','ground'],desc:'森林之灵的力量，让树木和植物成为天然的陷阱与武器。'},
  {id:'t50',name:'石化皮肤',rank:'b',cat:'talent',source:'原创',elements:['rock','ground'],desc:'石像鬼的身躯坚硬如岩，只有特定的攻击才能穿透。'},
  {id:'t51',name:'毒液麻痹',rank:'b',cat:'talent',source:'原创',elements:['poison','normal'],desc:'毒液在伤口中扩散，让猎物在痛苦中慢慢失去抵抗能力。'},
  {id:'t52',name:'地狱之火',rank:'a',cat:'talent',source:'原创',elements:['fire','dark'],desc:'来自地狱的低级恶魔，浑身上下都燃烧着永恒的业火。'},
  {id:'t53',name:'绞杀',rank:'b',cat:'talent',source:'原创',elements:['fighting','normal'],desc:'巨蟒的本能——用身体将猎物活活勒死，无需毒素也能致命。'},
  {id:'t54',name:'尸毒感染',rank:'b',cat:'talent',source:'原创',elements:['poison','ghost'],desc:'腐肉中的毒素会在伤口中扩散，即使只是轻伤也可能致命。'},
  {id:'t55',name:'夜行猎手',rank:'a',cat:'talent',source:'原创',elements:['dark','normal'],desc:'夜晚是属于猎手的舞台，在黑暗中他们的感知和力量都达到巅峰。'},
  {id:'t56',name:'陷阱精通',rank:'a',cat:'talent',source:'原创',elements:['normal','ground'],desc:'地精工程师的看家本领，他们的陷阱虽不总是靠谱，但数量足够多。'},
  {id:'t57',name:'恐惧光环',rank:'a',cat:'talent',source:'原创',elements:['dark','psychic'],desc:'幽灵与食尸鬼的死亡气息，能让意志薄弱者心生恐惧。'},
  {id:'t58',name:'狂暴血性',rank:'a',cat:'talent',source:'原创',elements:['fighting','fire'],desc:'半兽人骨子里的狂暴基因，越受伤越疯狂，是最可怕的战场疯子。'},
  {id:'t59',name:'火焰护盾',rank:'a',cat:'talent',source:'原创',elements:['fire','steel'],desc:'地狱铠甲的余烬，在受到攻击时释放毁灭性的热量。'},
  {id:'t60',name:'凤凰涅槃',rank:'legend',cat:'talent',source:'原创',elements:['fire','fairy'],desc:'浴火重生的传说，每一次死亡都是对生命的更深领悟。'},
  {id:'t61',name:'血之净化',rank:'ss',cat:'talent',source:'原创',elements:['dark','fairy'],desc:'红龙最令人敬畏的天赋——他能将血液中的毒素与邪能强行剥离。'},
  {id:'t62',name:'虚空瑶契约',rank:'legend',cat:'talent',source:'原创',elements:['dark','psychic'],desc:'与虚空灵兽的永恒契约，虚空瑶在战斗中伺机吞噬敌人的恐惧与绝望。'},
  {id:'t63',name:'预言之力',rank:'legend',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'命运三女神的眷顾，让拥有者得以窥见未来的片段。'},
  {id:'t64',name:'命运织线',rank:'legend',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'命运之线在指尖编织，能将偶然变为必然，将厄运化为幸运。'},
  {id:'t65',name:'北境之魂',rank:'a',cat:'talent',source:'原创',elements:['ice','fighting'],desc:'守夜人的誓言刻在骨血中，在最寒冷的长夜依然坚守岗位。'},
  {id:'pet01',name:'虚空瑶',rank:'ss',cat:'monster',source:'原创',elements:[],desc:'红龙的宠物，一头通体漆黑的神秘灵兽，能在虚实之间自由穿梭。它以负面情绪为食，能吞噬恐惧、绝望与愤怒。它没有固定的形态，像一团流动的暗影，却有着深邃而通人性的双眼。传说虚空瑶只认一位主人。'},
  {id:'hphp01',name:'霍恩·佩里',rank:'s',cat:'hero',source:'原创',elements:[],desc:'大难不死的男孩，在黑魔王的诅咒中幸存，成为魔法世界的希望。'},
  {id:'hpgot01',name:'乔恩·斯诺',rank:'s',cat:'hero',source:'原创',elements:[],desc:'守夜人总司令，临冬城的私生子，实际上是坦格利安血脉。'},
  {id:'mcu01',name:'铁壁·安格玛',rank:'s',cat:'hero',source:'原创',elements:[],desc:'铁炉堡首席锻造大师，用秘银与龙焰打造了一套可飞行、能发射烈焰弹幕的附魔战甲，是大陆最强的重装骑士。'},
  {id:'tw01',name:'埃德温·卡伦',rank:'s',cat:'hero',source:'原创',elements:[],desc:'高等血族亲王，并非低级亡灵，而是优雅的永生贵族，能读心、速度如闪电、皮肤坚硬如钻石。'},
  {id:'hphp02',name:'米娜·格朗',rank:'s',cat:'hero',source:'原创',elements:[],desc:'智慧超群的女巫，精通各类魔法与知识，是团队的大脑。'},
  {id:'hpgot02',name:'达妮·坦格利',rank:'s',cat:'hero',source:'原创',elements:[],desc:'龙之母，从软弱公主成长为铁王座的有力争夺者。'},
  {id:'mcu02',name:'圣光·罗杰斯',rank:'s',cat:'hero',source:'原创',elements:[],desc:'人族传奇圣骑士，手持精金圆盾，身披圣光之力，是正义与勇气的化身，一生从未在战场上后退半步。'},
  {id:'tw02',name:'贝莉·斯旺',rank:'s',cat:'hero',source:'原创',elements:[],desc:'拥有强大心灵护盾天赋的人类少女，后来转化为血族，成为埃德温的伴侣。'},
  {id:'hphp03',name:'罗伊·韦斯特',rank:'s',cat:'hero',source:'原创',elements:[],desc:'忠诚勇敢的好友，看似平凡却总能在关键时刻挺身而出。'},
  {id:'hpgot03',name:'提恩·兰尼',rank:'s',cat:'hero',source:'原创',elements:[],desc:'身高只有三尺，但智慧无人能敌的侏儒。'},
  {id:'mcu03',name:'雷霆·沃坦',rank:'s',cat:'hero',source:'原创',elements:[],desc:'阿萨神族至高神之子，掌控雷电风暴，手持雷霆神锤，能劈开一切黑暗，是世界上最强大的战士。'},
  {id:'tw03',name:'杰克·布莱克',rank:'s',cat:'hero',source:'原创',elements:[],desc:'狼人德鲁伊，能变身巨狼，体温极高，是血族的古老对手与盟友。'},
  {id:'hphp04',name:'阿尔伯特·丹布里',rank:'s',cat:'hero',source:'原创',elements:[],desc:'最伟大的白巫师，霍格沃茨校长，睿智而神秘的老者。'},
  {id:'hpgot04',name:'艾莉·斯塔克',rank:'s',cat:'hero',source:'原创',elements:[],desc:'从千金小姐蜕变为致命杀手的无面者。'},
  {id:'mcu04',name:'狂怒·布鲁斯',rank:'s',cat:'hero',source:'原创',elements:[],desc:'因接触上古诅咒，情绪激动时会化身为绿皮狂战士，力量与愤怒成正比，无人能正面抵挡其冲击。'},
  {id:'tw04',name:'卡莱尔·卡伦',rank:'s',cat:'hero',source:'原创',elements:[],desc:'血族长老，卡伦家族的大家长，曾是人类医师，是家族中的和平主义者。'},
  {id:'hphp05',name:'沃尔塔·莫尔',rank:'s',cat:'hero',source:'原创',elements:[],desc:'史上最危险的黑魔王，追求永生与绝对权力，是所有巫师的噩梦。'},
  {id:'hpgot05',name:'桑迪·斯塔克',rank:'s',cat:'hero',source:'原创',elements:[],desc:'从天真少女成长为精明的政治家，北境女王。'},
  {id:'mcu05',name:'暗影·娜塔莎',rank:'s',cat:'hero',source:'原创',elements:[],desc:'无面者组织传奇刺客，精通暗杀、间谍与魅惑之术，在地下世界有"黑寡妇"的称号，是最危险的女人。'},
  {id:'tw05',name:'爱丽丝·卡伦',rank:'s',cat:'hero',source:'原创',elements:[],desc:'血族预言家，能预见未来，活泼灵动，是家族的时尚顾问。'},
  {id:'mcu06',name:'鹰眼·克林特',rank:'s',cat:'hero',source:'原创',elements:[],desc:'精灵游侠冠军，百发百中的神射手，一箭能穿透巨龙的鳞甲，被称为"鹰之眼"。'},
  {id:'mcu07',name:'秘法·斯特兰奇',rank:'s',cat:'hero',source:'原创',elements:[],desc:'达拉然首席法师，前人类医师，因一次事故获得了操控时间、空间与维度的能力，是魔法世界的守护者。'},
  {id:'mcu08',name:'风暴·奥萝洛',rank:'s',cat:'hero',source:'原创',elements:[],desc:'风语者大德鲁伊，来自南方神秘大陆，能召唤雷电、飓风与暴雪，被称为"风暴女神"。'},
  {id:'mcu09',name:'金刚·罗根',rank:'s',cat:'hero',source:'原创',elements:[],desc:'兽人狂战士，双手能伸出精金利爪，拥有惊人的自愈能力，是活了千年的"不老战士"。'}

,{id:'t66',name:'宇宙意志',rank:'legend',cat:'talent',source:'原创',elements:['psychic','dragon'],desc:'来自宇宙诞生之初的意志，可操控时空与物质，是所有存在的终极本源'}
,{id:'t67',name:'时间裂隙',rank:'legend',cat:'talent',source:'原创',elements:['psychic','dark'],desc:'能在时间线上撕开裂隙，回溯过去或预知未来，是时间法师的终极天赋'}
,{id:'t68',name:'神格碎片',rank:'legend',cat:'talent',source:'原创',elements:['light','fairy'],desc:'诸神陨落后残留的神性碎片，持有者可获得部分神力'}
,{id:'t69',name:'混沌之源',rank:'legend',cat:'talent',source:'原创',elements:['dark','fire'],desc:'混沌力量的本源，可扭曲现实法则，让不可能变为可能'}
,{id:'t70',name:'命运终焉',rank:'legend',cat:'talent',source:'原创',elements:['psychic','fairy'],desc:'能看见所有生命的终点，并在关键时刻改写命运'}
,{id:'t71',name:'龙王血脉',rank:'ss',cat:'talent',source:'原创',elements:['dragon','fire'],desc:'体内流淌着上古龙王的血液，可觉醒龙族形态'}
,{id:'t72',name:'死亡骑士',rank:'ss',cat:'talent',source:'魔兽世界',elements:['dark','steel'],desc:'堕落的圣骑士，以死亡之力为武器，统御亡灵军团'}
,{id:'t73',name:'圣战先锋',rank:'ss',cat:'talent',source:'原创',elements:['light','fighting'],desc:'圣光教廷的精英战士，以信仰为盾，以圣火为剑'}
,{id:'t74',name:'虚空行者',rank:'ss',cat:'talent',source:'原创',elements:['dark','psychic'],desc:'能在虚空与现实间穿行，无视物理障碍'}
,{id:'t75',name:'自然之怒',rank:'ss',cat:'talent',source:'原创',elements:['grass','ground'],desc:'可召唤地震、风暴、洪水等自然灾变'}
,{id:'t76',name:'火焰专精',rank:'s',cat:'talent',source:'原创',elements:['fire'],desc:'对火焰的极致掌控，所有火系技能威力翻倍'}
,{id:'t77',name:'冰霜专精',rank:'s',cat:'talent',source:'原创',elements:['ice'],desc:'对冰霜的极致掌控，可冻结时间本身'}
,{id:'t78',name:'雷电专精',rank:'s',cat:'talent',source:'原创',elements:['electric'],desc:'对雷电的极致掌控，可化身雷霆化身'}
,{id:'t79',name:'暗影专精',rank:'s',cat:'talent',source:'原创',elements:['dark'],desc:'对暗影的极致掌控，可融入阴影中移动'}
,{id:'t80',name:'圣光专精',rank:'s',cat:'talent',source:'原创',elements:['light'],desc:'对圣光的极致掌控，可净化一切邪恶'}
,{id:'t81',name:'剑意化形',rank:'a',cat:'talent',source:'原创',elements:['steel','fighting'],desc:'剑意可化为实体，攻击范围大幅扩展'}
,{id:'t82',name:'法力涌动',rank:'a',cat:'talent',source:'原创',elements:['psychic'],desc:'法力回复速度大幅提升，可持续施法'}
,{id:'t83',name:'坚韧体魄',rank:'a',cat:'talent',source:'原创',elements:['normal','steel'],desc:'身体强度大幅提升，可承受更多伤害'}

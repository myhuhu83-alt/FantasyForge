<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FantasyForge 奇幻命名宝库 v2.0</title>
<style>
:root{--bg:#0a0a12;--bg-surface:#12101c;--bg-surface2:#1a1828;--border:#2a2440;--border2:#3a3450;--gold:#d4a853;--gold-dim:#a88a46;--gold-bright:#f0d080;--text:#e8e0d0;--text-muted:#7a7090;--text-muted2:#5a5070;--red:#c94040;--blue:#4090c9;--green:#50b060}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.5}
.hidden{display:none!important}
.text-center{text-align:center}
.text-muted{color:var(--text-muted)}

/* Header */
.header{text-align:center;padding:20px 20px 12px;background:linear-gradient(180deg,rgba(10,10,18,0) 0%,rgba(10,10,18,1) 100%)}
.header h1{font-size:2rem;letter-spacing:6px;font-weight:300;background:linear-gradient(180deg,#f0d88a 0%,#a07828 100%);-webkit-background-clip:text;background-clip:text;color:transparent;font-family:"Cinzel",Georgia,serif;margin-bottom:6px}
.header .subtitle{color:var(--text-muted);font-size:0.85rem;letter-spacing:2px}

/* Toolbar */
.toolbar{display:flex;gap:10px;padding:12px 20px;justify-content:center;flex-wrap:wrap;align-items:center}
.search-box{display:flex;align-items:center;background:var(--bg-surface);border:1px solid var(--border);border-radius:24px;padding:8px 16px;flex:0 1 360px;max-width:100%}
.search-box input{flex:1;background:none;border:none;outline:none;color:var(--text);font-size:0.9rem}
.search-box input::placeholder{color:var(--text-muted)}
.btn{padding:8px 16px;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-muted);border-radius:20px;cursor:pointer;font-size:0.85rem;transition:all 0.2s;white-space:nowrap}
.btn:hover{border-color:var(--gold-dim);color:var(--gold)}
.btn.on,.btn.active{background:var(--gold);color:#000;border-color:var(--gold)}

/* Nav */
.nav{display:flex;gap:6px;padding:8px 20px;justify-content:center;flex-wrap:wrap}
.nav-btn{padding:7px 14px;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-muted);border-radius:18px;cursor:pointer;font-size:0.82rem;transition:all 0.2s;white-space:nowrap}
.nav-btn:hover{border-color:var(--gold-dim);color:var(--gold)}
.nav-btn.on{background:var(--gold);color:#000;border-color:var(--gold)}
.cat-count{font-size:0.72rem;opacity:0.7;margin-left:3px}

/* Info bar */
.info-bar{display:flex;gap:16px;padding:6px 20px;justify-content:center;flex-wrap:wrap;font-size:0.82rem;color:var(--text-muted2)}
.info-bar .item{display:flex;align-items:center;gap:4px}
.info-bar .dot{width:8px;height:8px;border-radius:50%}
.legend-bar{display:flex;gap:12px;padding:8px 20px;justify-content:center;flex-wrap:wrap}
.legend-item{display:flex;align-items:center;gap:5px;font-size:0.75rem;color:var(--text-muted2)}
.legend-dot{width:10px;height:10px;border-radius:50%}

/* Element filter */
.el-filter{display:flex;gap:5px;padding:6px 20px;justify-content:center;flex-wrap:wrap}
.el-btn{display:inline-flex;align-items:center;gap:3px;padding:4px 10px;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-muted);border-radius:14px;cursor:pointer;font-size:0.75rem;transition:all 0.15s}
.el-btn:hover{color:var(--gold)}
.el-btn.on{background:rgba(212,168,83,0.2);color:var(--gold);border-color:var(--gold-dim)}
.el-btn .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* Map toggle */
.map-toggle{text-align:center;padding:10px 20px 0}
.map-toggle .btn{font-size:0.9rem;padding:8px 20px}

/* Map container */
.map-wrap{display:none;flex-direction:column;border-top:1px solid var(--border);margin:12px 20px 20px;border-radius:12px;overflow:hidden;background:var(--bg-surface)}
.map-wrap.on{display:flex}
.map-hdr{padding:12px 16px;background:rgba(15,12,22,0.98);border-bottom:1px solid rgba(160,130,90,0.3);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.map-hdr h3{font-size:1rem;color:var(--gold);letter-spacing:1px;font-weight:400;margin:0}
.map-hdr .meta{font-size:0.8rem;opacity:0.6}
.map-desc{padding:10px 16px 0;font-size:0.82rem;color:var(--text-muted);line-height:1.5}

/* Layer tabs */
.layer-tabs{display:flex;gap:6px;padding:10px 16px;background:rgba(10,10,16,0.95);border-bottom:1px solid rgba(100,100,120,0.2);flex-wrap:wrap}
.ltab{padding:5px 12px;border:1px solid rgba(150,130,90,0.3);background:rgba(20,18,30,0.8);color:var(--text-muted);border-radius:14px;cursor:pointer;font-size:0.8rem;transition:all 0.15s}
.ltab:hover{border-color:var(--gold-dim);color:var(--gold)}
.ltab.on{background:rgba(212,168,83,0.2);border-color:var(--gold-dim);color:var(--gold)}

/* Map main */
.map-main{flex:1;position:relative;padding:16px;min-height:420px}
.map-lay{position:absolute;inset:12px;opacity:1;transition:opacity 0.3s}
.map-lay.hidden{opacity:0;pointer-events:none}
.map-land{position:absolute;inset:0;border:1.5px solid rgba(180,140,90,0.25);border-radius:8px;box-shadow:inset 0 0 60px rgba(0,0,0,0.5),0 0 20px rgba(0,0,0,0.3)}

/* City icons */
.city-ic{position:absolute;display:flex;flex-direction:column;align-items:center;cursor:pointer;filter:drop-shadow(0 0 6px rgba(0,0,0,0.7));transition:transform 0.18s,filter 0.18s;z-index:5}
.city-ic:hover{transform:translateY(-4px) scale(1.1);filter:drop-shadow(0 0 14px rgba(212,168,83,0.4))}
.city-ic .mk{width:14px;height:14px;border-radius:50%;border:2px solid rgba(250,240,220,0.9);box-shadow:0 0 0 2px rgba(0,0,0,0.4);transition:all 0.15s}
.city-ic .lbl{margin-top:6px;font-size:0.72rem;text-shadow:0 2px 5px rgba(0,0,0,0.9);white-space:nowrap;color:var(--text)}
.city-ic[data-rank="legend"] .mk{animation:lpulse 2s ease-in-out infinite}
@keyframes lpulse{0%,100%{box-shadow:0 0 10px 4px rgba(212,168,83,0.6)}50%{box-shadow:0 0 18px 6px rgba(212,168,83,0.9)}}
.city-ic[data-rank="ss"] .mk{box-shadow:0 0 8px 3px rgba(160,100,220,0.5)}
.city-ic[data-rank="s"] .mk{box-shadow:0 0 6px 2px rgba(80,120,200,0.4)}
.city-ic[data-rank="d"] .mk{box-shadow:0 0 4px 2px rgba(120,120,100,0.4)}

/* Map tip */
.map-tip{position:absolute;pointer-events:none;opacity:0;transform:translateY(6px);transition:all 0.18s;background:rgba(10,8,16,0.97);border:1px solid rgba(180,150,90,0.5);border-radius:10px;padding:0;min-width:260px;max-width:320px;font-size:0.82rem;box-shadow:0 16px 40px rgba(0,0,0,0.6);z-index:20;overflow:hidden}
.map-tip.show{opacity:1;transform:translateY(0)}
.map-tip-hdr{padding:10px 12px;background:rgba(30,25,40,0.95);border-bottom:1px solid rgba(150,130,90,0.25);display:flex;justify-content:space-between;align-items:center}
.map-tip-hdr h4{margin:0;color:var(--gold);font-size:0.92rem}
.map-tip-hdr .rank{bg:gold;color:#000;padding:2px 8px;border-radius:10px;font-size:0.7rem;font-weight:600}
.map-tip-body{padding:10px 12px}
.map-tip-body p{margin:0 0 8px;line-height:1.45}
.map-tip-meta{display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:0.75rem;color:var(--text-muted)}
.map-tip-meta .row{display:flex;gap:4px}
.map-tip-meta .label{color:var(--text-muted2)}

/* Map legend */
.map-legend{position:absolute;right:12px;top:12px;background:rgba(10,8,16,0.92);border:1px solid rgba(150,120,90,0.3);border-radius:8px;padding:10px 12px;font-size:0.75rem;min-width:130px}
.map-legend h4{margin:0 0 8px;color:var(--gold);font-size:0.82rem}
.map-legend .r{display:flex;gap:6px;align-items:center;margin:4px 0}
.map-legend .mk-s{width:10px;height:10px;border-radius:50%;border:1px solid rgba(250,240,220,0.7);flex-shrink:0}
.map-legend .type-sep{margin:6px 0 4px;border-top:1px solid rgba(100,90,70,0.3)}

/* Faction list */
.faction-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;padding:12px}
.faction-card{padding:10px 12px;background:rgba(20,18,28,0.8);border:1px solid rgba(100,90,70,0.3);border-radius:8px;cursor:pointer;transition:all 0.15s}
.faction-card:hover{border-color:var(--gold-dim);background:rgba(30,28,40,0.9)}
.faction-card h5{margin:0 0 4px;font-size:0.85rem;color:var(--text)}
.faction-card p{margin:0;font-size:0.72rem;color:var(--text-muted);line-height:1.4}
.faction-card .type-tag{display:inline-block;padding:1px 6px;border-radius:8px;font-size:0.65rem;margin-top:4px}

/* Event toast */
.event-toast{position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-20px);background:rgba(10,8,16,0.98);border:1px solid var(--gold-dim);border-radius:10px;padding:12px 20px;font-size:0.9rem;opacity:0;transition:all 0.3s;pointer-events:none;z-index:100;max-width:400px;text-align:center}
.event-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.event-toast .icon{font-size:1.5rem;margin-bottom:4px}

/* Grid */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px;padding:16px;max-width:1600px;margin:0 auto}

/* Card */
.card{background:var(--bg-surface);border:1px solid var(--border);border-radius:12px;padding:14px;cursor:pointer;transition:all 0.2s;display:flex;flex-direction:column;gap:8px}
.card:hover{border-color:var(--gold-dim);transform:translateY(-2px);box-shadow:0 12px 24px rgba(0,0,0,0.3)}
.card.highlight{border-color:var(--gold);box-shadow:0 0 24px rgba(212,168,83,0.35);animation:cardPulse 0.5s}
@keyframes cardPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.02)}}
.card-header{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.card-name{font-weight:600;color:var(--text);font-size:0.95rem}
.card-source{background:rgba(212,168,83,0.12);color:var(--gold);padding:2px 8px;border-radius:6px;font-size:0.7rem;white-space:nowrap}
.card-desc{font-size:0.82rem;color:var(--text-muted);line-height:1.5;flex:1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
.card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:8px;border-top:1px solid rgba(42,36,64,0.3)}
.elements{display:flex;gap:3px;flex-wrap:wrap}
.el-dot{width:12px;height:12px;border-radius:50%;cursor:pointer}
.rank-tag{padding:2px 8px;border-radius:10px;font-size:0.7rem;font-weight:600}
.empty{text-align:center;padding:60px 20px;color:var(--text-muted2)}
.empty-icon{font-size:3.5rem;margin-bottom:12px;opacity:0.3}

/* Toast */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.88);color:#fff;padding:10px 20px;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.3);font-size:0.85rem;opacity:0;pointer-events:none;transition:opacity 0.2s;z-index:100}
.toast.show{opacity:1}

/* Modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:200;opacity:0;pointer-events:none;transition:opacity 0.2s}
.modal-overlay.show{opacity:1;pointer-events:auto}
.modal{background:var(--bg-surface2);border:1px solid var(--border2);border-radius:12px;max-width:500px;width:90%;max-height:80vh;overflow-y:auto;transform:scale(0.95);transition:transform 0.2s}
.modal-overlay.show .modal{transform:scale(1)}
.modal-hdr{padding:16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--bg-surface2);z-index:1}
.modal-hdr h3{margin:0;color:var(--gold);font-size:1.1rem}
.modal-close{background:none;border:none;color:var(--text-muted);font-size:1.5rem;cursor:pointer;line-height:1}
.modal-close:hover{color:var(--text)}
.modal-body{padding:16px}
.modal-section{margin-bottom:16px}
.modal-section:last-child{margin-bottom:0}
.modal-section h4{color:var(--gold);font-size:0.85rem;margin:0 0 8px}
.modal-section p{color:var(--text-muted);font-size:0.85rem;margin:0;line-height:1.5}
.modal-tags{display:flex;flex-wrap:wrap;gap:6px}
.modal-tag{display:inline-block;padding:4px 10px;background:rgba(212,168,83,0.1);border:1px solid rgba(212,168,83,0.3);border-radius:12px;font-size:0.75rem;color:var(--text-muted)}

/* Responsive */
@media(max-width:768px){
  .header h1{font-size:1.5rem}
  .grid{grid-template-columns:1fr;padding:12px}
  .search-box{flex:1 1 100%}
  .map-main{min-height:300px}
  .map-legend{font-size:0.7rem;min-width:110px}
  .faction-list{grid-template-columns:1fr}
}

/* Character Builder Modal */
.char-builder{padding:20px}
.char-step{margin-bottom:20px;padding:15px;background:rgba(20,18,28,0.8);border-radius:10px;border:1px solid var(--border)}
.char-step h4{color:var(--gold);margin:0 0 10px;font-size:0.9rem}
.char-options{display:flex;flex-wrap:wrap;gap:8px}
.char-option{padding:8px 12px;background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:0.8rem;transition:all 0.15s}
.char-option:hover{border-color:var(--gold-dim)}
.char-option.selected{background:rgba(212,168,83,0.2);border-color:var(--gold);color:var(--gold)}
.char-result{margin-top:20px;padding:15px;background:rgba(30,25,40,0.9);border-radius:10px;border:1px solid var(--gold-dim)}
.char-result h4{color:var(--gold);margin:0 0 10px}
.char-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px}
.char-stat{text-align:center;padding:8px;background:rgba(20,18,28,0.8);border-radius:6px}
.char-stat .val{font-size:1.2rem;color:var(--gold)}
.char-stat .label{font-size:0.7rem;color:var(--text-muted)}

/* Party Generator */
.party-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;padding:15px}
.party-member{padding:15px;background:rgba(20,18,28,0.8);border-radius:10px;border:1px solid var(--border)}
.party-member h5{color:var(--gold);margin:0 0 10px}
.party-slot{padding:6px 10px;background:var(--bg-surface);border-radius:6px;margin:4px 0;font-size:0.8rem}
.party-synergy{margin-top:15px;padding:10px;background:rgba(212,168,83,0.1);border-radius:8px}

/* Codex Progress */
.codex-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:15px}
.codex-cat{padding:12px;background:rgba(20,18,28,0.8);border-radius:10px;border:1px solid var(--border)}
.codex-cat h5{color:var(--gold);margin:0 0 8px;display:flex;justify-content:space-between}
.codex-bar{height:8px;background:var(--bg-surface);border-radius:4px;overflow:hidden}
.codex-fill{height:100%;background:linear-gradient(90deg,var(--gold-dim),var(--gold));transition:width 0.3s}
.codex-stats{display:flex;justify-content:space-between;margin-top:6px;font-size:0.75rem;color:var(--text-muted)}

/* Battle Simulator */
.battle-arena{display:flex;gap:20px;padding:20px;justify-content:center}
.battle-side{flex:1;max-width:300px;padding:15px;background:rgba(20,18,28,0.8);border-radius:10px;border:2px solid var(--border)}
.battle-side.left{border-color:rgba(100,150,200,0.5)}
.battle-side.right{border-color:rgba(200,100,100,0.5)}
.battle-side h4{color:var(--gold);margin:0 0 10px;text-align:center}
.battle-vs{text-align:center;padding:20px;font-size:2rem;color:var(--gold)}
.battle-log{max-height:200px;overflow-y:auto;padding:10px;background:rgba(10,8,16,0.9);border-radius:8px;margin-top:15px}
.battle-log p{margin:4px 0;font-size:0.8rem;line-height:1.4}
.battle-log .dmg{color:#c94040}
.battle-log .heal{color:#50b060}
.battle-log .info{color:var(--text-muted)}

/* Rank Visual Enhancement */
.card[data-rank="legend"]{border-color:rgba(230,201,122,0.8);box-shadow:0 0 20px rgba(230,201,122,0.3)}
.card[data-rank="ss"]{border-color:rgba(160,112,208,0.7);box-shadow:0 0 15px rgba(160,112,208,0.2)}
.card[data-rank="s"]{border-color:rgba(106,156,207,0.6)}
.card[data-rank="a"]{border-color:rgba(112,208,128,0.5)}
.card[data-rank="b"]{border-color:rgba(199,199,122,0.4)}
.card[data-rank="c"]{border-color:rgba(199,155,86,0.3)}
.card[data-rank="d"]{border-color:rgba(153,95,44,0.3)}
.card[data-rank="e"]{border-color:rgba(102,74,41,0.3)}

/* Legend Card Animation */
.card[data-rank="legend"]::before{content:'';position:absolute;inset:-2px;background:linear-gradient(45deg,transparent,rgba(230,201,122,0.3),transparent);animation:legendShine 3s infinite;pointer-events:none;border-radius:12px}
@keyframes legendShine{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

/* Stats Dashboard */
.stats-dashboard{display:flex;gap:15px;padding:10px 20px;justify-content:center;flex-wrap:wrap;background:rgba(15,12,22,0.5);border-bottom:1px solid var(--border)}
.stat-item{display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--bg-surface);border-radius:20px;font-size:0.8rem}
.stat-item .icon{font-size:1rem}
.stat-item .val{color:var(--gold);font-weight:600}
.stat-item .label{color:var(--text-muted)}

/* Advanced Filter */
.adv-filter{display:flex;gap:10px;padding:8px 20px;justify-content:center;flex-wrap:wrap;background:rgba(15,12,22,0.3)}
.filter-group{display:flex;gap:4px;align-items:center}
.filter-group .label{font-size:0.75rem;color:var(--text-muted2);margin-right:4px}
.rank-btn{padding:4px 8px;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-muted);border-radius:12px;cursor:pointer;font-size:0.72rem;transition:all 0.15s}
.rank-btn:hover{border-color:var(--gold-dim)}
.rank-btn.on{background:rgba(212,168,83,0.2);border-color:var(--gold-dim);color:var(--gold)}
.source-select{padding:4px 8px;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-muted);border-radius:12px;font-size:0.72rem;cursor:pointer}
</style>
</head>
<body>

<div class="header">
  <h1>⚔ FANTASY FORGE</h1>
  <div class="subtitle">五层世界 · 奇幻命名宝库 v2.0</div>
<div class="stats-dashboard" id="statsDashboard"></div>
<div class="adv-filter" id="advFilter"></div>

</div>

<div class="toolbar">
  <div class="search-box">
    <input type="text" id="searchInput" placeholder="搜索名称、来源、描述..." autocomplete="off">
  </div>
  <button class="btn" id="randomBtn" onclick="randomPick()">🎲 随机灵感</button>
  <button class="btn" onclick="showAllCollection()">📚 我的收藏</button>
    <button class="btn" onclick="openCharBuilder()">🧙 角色构建</button>
    <button class="btn" onclick="randomParty()">👥 随机组队</button>
    <button class="btn" onclick="openCodex()">📖 图鉴进度</button>
    <button class="btn" onclick="openBattleSim()">⚔️ 对战模拟</button>

</div>

<div class="nav" id="nav"></div>
<div class="info-bar" id="infoBar"></div>
<div class="el-filter" id="elFilter"></div>
<div class="legend-bar" id="legend"></div>

<div class="map-toggle">
  <button class="btn" id="mapToggle" onclick="toggleMap()">🗺️ 世界地图</button>
  <button class="btn" onclick="triggerRandomEvent()">🎯 随机事件</button>
</div>

<div class="map-wrap" id="mapWrap">
  <div class="map-hdr">
    <h3 id="layerTitle">主物质界</h3>
    <div class="meta" id="layerSubtitle">凡世 · 七大王國</div>
  </div>
  <div class="map-desc" id="layerDesc">这里是凡人居住的物质世界，广阔的大陆上分布着人类、兽人、精灵、矮人的王国。</div>
  <div class="layer-tabs" id="layerTabs">
    <button class="ltab on" data-layer="surface" onclick="switchLayer('surface')">🏔️ 主物质界</button>
    <button class="ltab" data-layer="sky" onclick="switchLayer('sky')">☁️ 天空界</button>
    <button class="ltab" data-layer="underground" onclick="switchLayer('underground')">🌑 地底界</button>
    <button class="ltab" data-layer="abyss" onclick="switchLayer('abyss')">🌀 深渊虚空界</button>
    <button class="ltab" data-layer="cosmic" onclick="switchLayer('cosmic')">✨ 星界</button>
    <button class="ltab" data-layer="faction" onclick="switchLayer('faction')">⚔️ 势力总览</button>
  </div>
  <div class="map-main" id="mapMain">
    <!-- Layer: Surface -->
    <div class="map-lay" id="lay-surface">
      <div class="map-land"></div>
      <div class="city-ic" style="top:14%;left:22%" data-id="stormwind" data-rank="ss" data-layer="surface"><div class="mk" style="background:#e6c97a"></div><div class="lbl">暴风城</div></div>
      <div class="city-ic" style="top:12%;left:38%" data-id="orgri" data-rank="ss" data-layer="surface"><div class="mk" style="background:#7a2a2a"></div><div class="lbl">奥格瑞玛</div></div>
      <div class="city-ic" style="top:10%;left:58%" data-id="silvermoon" data-rank="ss" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">银月城</div></div>
      <div class="city-ic" style="top:30%;left:48%" data-id="minas" data-rank="ss" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">米纳斯提里斯</div></div>
      <div class="city-ic" style="top:28%;left:68%" data-id="lothlorien" data-rank="ss" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">洛丝萝莲</div></div>
      <div class="city-ic" style="top:26%;left:32%" data-id="erath" data-rank="ss" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">埃雷萨拉斯</div></div>
      <div class="city-ic" style="top:34%;left:18%" data-id="khaz" data-rank="ss" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">刚达巴</div></div>
      <div class="city-ic" style="top:42%;left:52%" data-id="shire" data-rank="c" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">夏尔</div></div>
      <div class="city-ic" style="top:48%;left:42%" data-id="bree" data-rank="c" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">布里</div></div>
      <div class="city-ic" style="top:52%;left:62%" data-id="crossroads" data-rank="c" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">十字路口</div></div>
      <div class="city-ic" style="top:35%;left:78%" data-id="pallet" data-rank="c" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">真新镇</div></div>
      <div class="city-ic" style="top:44%;left:72%" data-id="newbark" data-rank="c" data-layer="surface"><div class="mk" style="background:#6a9ccf"></div><div class="lbl">常磐市</div></div>
      <div class="city-ic" style="top:70%;left:60%" data-id="atlanta" data-rank="legend" data-layer="surface"><div class="mk" style="background:#a87a3a"></div><div class="lbl">亚特兰大</div></div>
      <div class="map-legend"><h4>势力图例</h4><div class="r"><div class="mk-s" style="background:#e6c97a"></div><span>联盟</span></div><div class="r"><div class="mk-s" style="background:#7a2a2a"></div><span>部落</span></div><div class="r"><div class="mk-s" style="background:#6a9ccf"></div><span>中立</span></div><div class="r"><div class="mk-s" style="background:#a87a3a"></div><span>废土</span></div></div>
    </div>

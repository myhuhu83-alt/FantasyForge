    <div class="map-lay hidden" id="lay-sky">
      <div class="map-land"></div>
      <div class="city-ic" style="top:32%;left:38%" data-id="dalaran" data-rank="ss" data-layer="sky"><div class="mk" style="background:#87b0ff"></div><div class="lbl">达拉然</div></div>
      <div class="city-ic" style="top:40%;left:62%" data-id="riven" data-rank="d" data-layer="sky"><div class="mk" style="background:#87b0ff"></div><div class="lbl">史盖利格</div></div>
      <div class="map-legend"><h4>天空界</h4><div class="r"><div class="mk-s" style="background:#87b0ff"></div><span>魔法城市</span></div><div class="r"><div class="mk-s" style="background:#a070d0"></div><span>学院</span></div></div>
